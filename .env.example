# Optional search-engine ownership tokens. Set these in the production
# environment only, then redeploy before completing verification.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=

# Optional IndexNow CLI overrides. The CLI reads exported shell variables;
# it does not automatically load this file. Defaults work without configuration.
INDEXNOW_SITE_URL=https://www.886studios.com
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_KEY_FILE=indexnow-key.txt
# Public ownership key override; must match the deployed key file.
INDEXNOW_KEY=
