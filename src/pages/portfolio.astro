---
import PageHero from "../components/PageHero.astro";
import { portfolioCompanies } from "../data/siteContent";
import BaseLayout from "../layouts/BaseLayout.astro";

const alphabeticalPortfolioCompanies = [...portfolioCompanies].sort((a, b) =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base", ignorePunctuation: true }),
);
---

<BaseLayout
  title="Portfolio — 886 Studios"
  description="Startups backed by 886 Studios."
>
  <div class="portfolio-page">
    <PageHero
      eyebrow="Portfolio"
      title="Startups backed by us"
      titleId="portfolio-title"
      showDivider={false}
    />

    <section class="portfolio-directory section" aria-labelledby="portfolio-directory-title">
      <h2 class="sr-only" id="portfolio-directory-title">Portfolio companies</h2>
      <ul class="portfolio-list portfolio-list--directory" aria-label="Portfolio companies">
        {
          alphabeticalPortfolioCompanies.map((item) => (
            <li class="portfolio-row">
              <a class="portfolio-link" href={`/portfolio/${item.slug}`}>
                <span class="portfolio-logo-mark" aria-hidden="true">
                  <img
                    class:list={["portfolio-logo-image", item.logo.imageClass]}
                    src={item.logo.src}
                    alt=""
                    width={item.logo.width}
                    height={item.logo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="portfolio-name-group">
                  <span class="portfolio-name">{item.name}</span>
                  <span class="portfolio-category">{item.category}</span>
                </span>
                <span class="portfolio-meta">
                  <span class="sr-only">Open {item.name} portfolio page</span>
                  <span class="portfolio-indicator" aria-hidden="true"></span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
