---
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import { getGoogleAnalyticsId, siteConfig } from "../config/site";
import { siteContent } from "../data/siteContent";

const applicationUrl = siteContent.nav.cta.href;
const googleAnalyticsId = getGoogleAnalyticsId();
---

<html lang="en">
  <head>
    <GoogleAnalytics measurementId={googleAnalyticsId} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${applicationUrl}`} />
    <title>{`Redirecting to application - ${siteConfig.name}`}</title>
  </head>
  <body>
    <script is:inline define:vars={{ applicationUrl }}>window.location.replace(applicationUrl);</script>
    <main>
      <p>Redirecting to application form... <a href={applicationUrl}>Click here</a> if not redirected.</p>
    </main>
  </body>
</html>
