---
import { getCollection, render } from "astro:content";
import BlogPostPage from "../../components/pages/BlogPostPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getBlogPostPath,
  getBlogPostTitle,
  type BlogPost,
} from "../../lib/blog";
import { getBlogArticleSchema } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
const pagePath = getBlogPostPath(post);
---

<BaseLayout
  title={getBlogPostTitle(post)}
  description={post.data.description}
  ogImage={post.data.image.src}
  ogImageAlt={post.data.image.alt}
  ogImageWidth={post.data.image.width}
  ogImageHeight={post.data.image.height}
  ogType="article"
  breadcrumbs={[
    { name: "Blog", path: "/blog" },
    { name: post.data.title, path: pagePath },
  ]}
  structuredData={getBlogArticleSchema(post, pagePath)}
>
  <BlogPostPage post={post} Content={Content} />
</BaseLayout>
