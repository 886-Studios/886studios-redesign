---
import BlogPage from "../../components/pages/BlogPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBlogPosts, getLatestBlogModifiedDate } from "../../lib/blog";
import { pageMeta } from "../../lib/seo";

const posts = await getBlogPosts();
const dateModified = getLatestBlogModifiedDate(posts);
---

<BaseLayout
  title={pageMeta.blog.title}
  description={pageMeta.blog.description}
  dateModified={dateModified}
  pageType="CollectionPage"
  breadcrumbs={[{ name: "Blog", path: "/blog" }]}
  structuredData={{
    "@type": "CollectionPage",
    "@id": "https://www.886studios.com/blog#blog",
    name: "886 Studios Blog",
    description: pageMeta.blog.description,
    dateModified,
    url: "https://www.886studios.com/blog",
    isPartOf: { "@id": "https://www.886studios.com/#website" },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.map((post, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: post.title,
        url: `https://www.886studios.com/blog/${post.slug}`,
      })),
    },
  }}
>
  <BlogPage posts={posts} />
</BaseLayout>
