---
import AboutTeam from "../components/AboutTeam.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteContent } from "../data/siteContent";
import { getPeopleItemListSchema, pageMeta } from "../lib/seo";

const { careers } = siteContent.about;
---

<BaseLayout
  title={pageMeta.team.title}
  description={pageMeta.team.description}
  pageType="AboutPage"
  breadcrumbs={[
    { name: "About us", path: "/about" },
    { name: "Team", path: "/team" },
  ]}
  structuredData={getPeopleItemListSchema("/team")}
>
  <div class="page" id="page-team">
    <PageHero title="Team" accentHeader />
    <div class="section">
      <AboutTeam />

      <hr class="divider divider--spaced">

      <div class="reveal reveal-delay-1" id="careers">
        <h2 class="section-tag" id="team-careers-title">{careers.title}</h2>
        <section class="team-careers" aria-labelledby="team-careers-title">
          <div class="team-careers-copy">
            {careers.paragraphs.map((paragraph) => <p class="prose">{paragraph}</p>)}
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
