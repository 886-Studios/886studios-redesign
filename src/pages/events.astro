---
import EventsPage from "../components/pages/EventsPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLumaEvents } from "../lib/luma";
import { getEventsStructuredData, pageMeta } from "../lib/seo";

const lumaEvents = getLumaEvents();
const allEvents = [...lumaEvents.upcomingEvents, ...lumaEvents.pastEvents];
---

<BaseLayout
  title={pageMeta.events.title}
  description={pageMeta.events.description}
  pageType="CollectionPage"
  breadcrumbs={[{ name: "Events", path: "/events" }]}
  structuredData={getEventsStructuredData(allEvents)}
>
  <EventsPage lumaEvents={lumaEvents} />
</BaseLayout>
