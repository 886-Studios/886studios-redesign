---
import PartnerProfilePage from "../../components/pages/PartnerProfilePage.astro";
import { partnerProfiles } from "../../data/partnerProfiles";
import type { PartnerProfile } from "../../data/partnerProfiles";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAbsoluteUrl, getPersonSchema, getProfileDescription } from "../../lib/seo";

export function getStaticPaths() {
  return partnerProfiles.map((profile) => ({
    params: { slug: profile.slug },
    props: { profile },
  }));
}

const { profile } = Astro.props as { profile: PartnerProfile };
const profileDescription = getProfileDescription(profile);
---

<BaseLayout
  title={`${profile.name} — 886 Studios Profile`}
  description={profileDescription}
  ogImage={getAbsoluteUrl(profile.photo)}
  ogImageAlt={`${profile.name}, ${profile.company}`}
  ogImageWidth={400}
  ogImageHeight={400}
  ogImageType="image/webp"
  pageType="ProfilePage"
  breadcrumbs={[
    { name: "About", path: "/about" },
    { name: profile.name, path: `/about/${profile.slug}` },
  ]}
  structuredData={getPersonSchema(profile)}
  hideFooterSocials
>
  <PartnerProfilePage profile={profile} />
</BaseLayout>
