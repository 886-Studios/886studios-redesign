---
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import VercelAnalytics from "../../components/VercelAnalytics.astro";
import { getGoogleAnalyticsId, siteConfig } from "../../config/site";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content="0;url=/manifesto" />
    <link rel="canonical" href={`${siteConfig.url}/manifesto`} />
    <title>Manifesto has moved | 886 Studios</title>
    <GoogleAnalytics measurementId={getGoogleAnalyticsId()} />
  </head>
  <body>
    <main>
      <p><a href="/manifesto">Continue to Manifesto</a></p>
    </main>
    <script>
      window.location.replace(`/manifesto${window.location.search}${window.location.hash}`);
    </script>
    <VercelAnalytics />
  </body>
</html>
