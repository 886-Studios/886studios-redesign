---
import { portfolioCompanies } from "../../data/siteContent";
import type { PortfolioCompany } from "../../data/siteContent";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return portfolioCompanies.map((company) => ({
    params: { slug: company.slug },
    props: { company },
  }));
}

const { company } = Astro.props as { company: PortfolioCompany };
const pageTitle = `${company.name} — 886 Studios Portfolio`;
const pageDescription = `${company.name}: ${company.description}`;
const externalLinks = [
  { label: "Website", href: company.websiteUrl },
  { label: "App Store", href: company.appStoreUrl },
  { label: "Google Play", href: company.playStoreUrl },
].filter((link): link is { label: string; href: string } => typeof link.href === "string" && link.href.length > 0);
const companyInitials =
  company.name
    .replace(/\bby\b/gi, "")
    .replace(/[^a-z0-9\s]/gi, " ")
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join("") || company.name.charAt(0).toUpperCase();
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <article class="startup-detail-page">
    <section class="startup-detail-shell" aria-labelledby="startup-detail-title">
      <a class="startup-back-link" href="/portfolio">&larr; Back to portfolio</a>

      <div class="startup-detail-main">
        <div class="startup-detail-heading">
          <div class="startup-detail-mark" aria-hidden="true">{companyInitials}</div>
          <div class="startup-detail-copy">
            <h1 class="startup-detail-title" id="startup-detail-title">{company.name}</h1>
            <p class="startup-detail-lead">{company.description}</p>
          </div>
        </div>

        {
          externalLinks.length > 0 && (
            <div class="startup-detail-actions" aria-label={`${company.name} links`}>
              {externalLinks.map((link) => (
                <a
                  class="startup-detail-cta"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label} &rarr;
                </a>
              ))}
            </div>
          )
        }
      </div>

      <aside class="startup-detail-sidebar" aria-label={`${company.name} facts`}>
        <dl class="startup-detail-facts">
          <div>
            <dt>Category</dt>
            <dd>{company.category}</dd>
          </div>
          {
            company.program && (
              <div>
                <dt>Program</dt>
                <dd>{company.program}</dd>
              </div>
            )
          }
        </dl>
      </aside>
    </section>
  </article>
</BaseLayout>
