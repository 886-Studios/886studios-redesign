  <div class="draft-end">
    <a class="draft-link" href="/events">Explore events<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7" /></svg></a>
    <a class="draft-link" href="/contact">Contact us<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7" /></svg></a>
