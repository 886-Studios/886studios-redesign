---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import "../styles/draft-pages.css";

interface Props {
  title: string;
  section: string;
  lead?: string;
  accentHeader?: boolean;
}

const { title, section, lead, accentHeader } = Astro.props;
---

<BaseLayout
  title={`${title} | 886 Studios`}
  description={`${title}, part of ${section} at 886 Studios.`}
  robots="noindex, follow"
>
  <div class="page draft-page">
    <PageHero title={title} lead={lead} accentHeader={accentHeader}>
      <p class="draft-notice">Draft page · Placeholder copy</p>
    </PageHero>
    <div class="draft-content">
      <slot />
    </div>
  </div>
</BaseLayout>
