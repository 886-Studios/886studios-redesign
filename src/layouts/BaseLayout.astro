---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  hideFooterSocials?: boolean;
}

const {
  title = "886 Studios",
  description = "Newsletter →",
  ogImage = "https://images.spr.so/cdn-cgi/imagedelivery/j42No7y-dcokJuNgXeA0ig/a3afedd0-7225-4cad-930f-bc3e1d574804/886_banner/public",
  hideFooterSocials = false,
} = Astro.props;

const siteUrl = "https://886studios.com";
const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const canonicalUrl = currentPath === "/" ? siteUrl : `${siteUrl}${currentPath}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="886 Studios" />
    <meta property="og:site_name" content="886 Studios" />
    <meta property="og:locale" content="en-US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@886Studios" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="886 Studios" />

    <meta name="theme-color" content="#050507" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/avif" href="/favicon.avif" />
    <link rel="shortcut icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="32x32" href="/favicon-32.png" />
    {currentPath === "/" && <link rel="preload" as="image" href="/assets/hero/sf-tpe-hero.jpg" fetchpriority="high" />}
    {
      currentPath === "/programs" && (
        <link
          rel="preload"
          as="image"
          href="/assets/programs/ikigai-audience-theater-1280.webp"
          imagesrcset="/assets/programs/ikigai-audience-theater-1280.webp 1280w, /assets/programs/ikigai-audience-theater-1920.webp 1920w"
          imagesizes="(max-width: 640px) calc(100vw - 36px), min(calc(100vw - 48px), 1160px)"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[currentPath === "/" && "is-home"]}>
    <SiteNav currentPath={currentPath} />
    <slot />
    <SiteFooter hideSocials={hideFooterSocials} />
    <Analytics />
  </body>
</html>
