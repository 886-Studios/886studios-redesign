---
import "../styles/global.css";
import ApplicationBanner from "../components/ApplicationBanner.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import VercelAnalytics from "../components/VercelAnalytics.astro";
import {
  getCanonicalUrl,
  getGoogleAnalyticsId,
  getRouteImagePreloads,
  normalizePath,
  siteConfig,
} from "../config/site";
import {
  getAbsoluteUrl,
  getStructuredDataGraph,
  type BreadcrumbItem,
  type JsonLdObject,
  type PageSchemaType,
} from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogType?: string;
  robots?: string;
  pageType?: PageSchemaType;
  breadcrumbs?: BreadcrumbItem[];
  structuredData?: JsonLdObject | JsonLdObject[];
  hideFooterSocials?: boolean;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  ogImage = siteConfig.defaultOgImage,
  ogImageAlt = siteConfig.ogImageAlt,
  ogImageWidth = siteConfig.defaultOgImageWidth,
  ogImageHeight = siteConfig.defaultOgImageHeight,
  ogImageType = siteConfig.defaultOgImageType,
  ogType = "website",
  robots = "index, follow",
  pageType = "WebPage",
  breadcrumbs,
  structuredData,
  hideFooterSocials = false,
} = Astro.props;

const currentPath = normalizePath(Astro.url.pathname);
const isPortfolioProfilePage = currentPath.startsWith("/portfolio/");
const showSocialPreview = currentPath === "/";
const showSocialPreviewImage = showSocialPreview && Boolean(ogImage);
const canonicalUrl = getCanonicalUrl(currentPath);
const absoluteOgImage = showSocialPreviewImage ? getAbsoluteUrl(ogImage) : undefined;
const googleAnalyticsId = getGoogleAnalyticsId();
const routeImagePreloads = getRouteImagePreloads(currentPath);
const structuredDataJson = JSON.stringify(
  getStructuredDataGraph({
    path: currentPath,
    title,
    description,
    pageType,
    breadcrumbs,
    additionalSchema: structuredData,
    image: absoluteOgImage
      ? {
          url: absoluteOgImage,
          alt: ogImageAlt,
          width: ogImageWidth,
          height: ogImageHeight,
        }
      : undefined,
  }),
).replace(/</g, "\\u003c");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={siteConfig.name} />
    <meta name="author" content={siteConfig.name} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    {
      showSocialPreview && (
        <>
          <meta property="og:type" content={ogType} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          {
            absoluteOgImage && (
              <>
                <meta property="og:image" content={absoluteOgImage} />
                <meta property="og:image:secure_url" content={absoluteOgImage} />
                <meta property="og:image:type" content={ogImageType} />
                <meta property="og:image:width" content={String(ogImageWidth)} />
                <meta property="og:image:height" content={String(ogImageHeight)} />
                <meta property="og:image:alt" content={ogImageAlt} />
              </>
            )
          }
          <meta property="og:site_name" content={siteConfig.name} />
          <meta property="og:locale" content={siteConfig.ogLocale} />
          <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
          <meta name="twitter:site" content={siteConfig.twitterSite} />
          <meta name="twitter:domain" content="886studios.com" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          {
            absoluteOgImage && (
              <>
                <meta name="twitter:image" content={absoluteOgImage} />
                <meta name="twitter:image:alt" content={ogImageAlt} />
              </>
            )
          }
        </>
      )
    }

    <meta name="theme-color" content={siteConfig.themeColor} />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/avif" href="/favicon.avif" />
    <link rel="shortcut icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="32x32" href="/favicon-32.png" />
    {
      routeImagePreloads.map((image) => (
        <link
          rel="preload"
          as="image"
          href={image.href}
          imagesrcset={image.srcset}
          imagesizes={image.sizes}
          type={image.type}
          fetchpriority="high"
        />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <GoogleAnalytics measurementId={googleAnalyticsId} />
    <script type="application/ld+json" is:inline set:html={structuredDataJson} />
  </head>
  <body class:list={[currentPath === "/" && "is-home", isPortfolioProfilePage && "is-portfolio-profile"]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteNav currentPath={currentPath} />
    <ApplicationBanner />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter hideSocials={hideFooterSocials} />
    <VercelAnalytics />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
