---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import VercelAnalytics from "../components/VercelAnalytics.astro";
import {
  getCanonicalUrl,
  getGoogleAnalyticsId,
  getRouteImagePreloads,
  normalizePath,
  siteConfig,
} from "../config/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  hideFooterSocials?: boolean;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  ogImage = siteConfig.defaultOgImage,
  hideFooterSocials = false,
} = Astro.props;

const currentPath = normalizePath(Astro.url.pathname);
const canonicalUrl = getCanonicalUrl(currentPath);
const googleAnalyticsId = getGoogleAnalyticsId();
const routeImagePreloads = getRouteImagePreloads(currentPath);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={siteConfig.ogImageAlt} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.twitterSite} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={siteConfig.ogImageAlt} />

    <meta name="theme-color" content={siteConfig.themeColor} />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/avif" href="/favicon.avif" />
    <link rel="shortcut icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="32x32" href="/favicon-32.png" />
    {
      routeImagePreloads.map((image) => (
        <link
          rel="preload"
          as="image"
          href={image.href}
          imagesrcset={image.srcset}
          imagesizes={image.sizes}
          type={image.type}
          fetchpriority="high"
        />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <GoogleAnalytics measurementId={googleAnalyticsId} />
  </head>
  <body class:list={[currentPath === "/" && "is-home"]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteNav currentPath={currentPath} />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter hideSocials={hideFooterSocials} />
    <VercelAnalytics />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
