---
import { siteContent } from "../data/siteContent";

const { launchpad } = siteContent.programs;
---

<aside
  class="application-banner"
  aria-label="Applications open"
  data-application-banner
>
  <div class="application-banner-inner">
    <div class="application-banner-message">
      <p>{launchpad.status.announcement}</p>
      <a
        href={launchpad.cta.href}
        target="_blank"
        rel="noopener noreferrer"
      >Apply now</a>
    </div>
    <button
      class="application-banner-close"
      type="button"
      aria-label="Dismiss applications announcement"
      data-application-banner-close
    >
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M4.5 4.5l11 11m0-11-11 11" />
      </svg>
    </button>
  </div>
</aside>

<script>
  const applicationBanner = document.querySelector<HTMLElement>("[data-application-banner]");
  const applicationBannerClose = document.querySelector<HTMLButtonElement>(
    "[data-application-banner-close]",
  );
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const storageKey = "886-launchpad-fall-2026-banner-dismissed";

  try {
    if (window.sessionStorage.getItem(storageKey) === "true") {
      applicationBanner?.setAttribute("hidden", "");
    }
  } catch {
    // The announcement remains visible when storage is unavailable.
  }

  applicationBannerClose?.addEventListener("click", () => {
    if (!applicationBanner) return;

    const hideBanner = () => applicationBanner.setAttribute("hidden", "");

    if (reducedMotion.matches) {
      hideBanner();
    } else {
      applicationBanner.classList.add("is-closing");
      window.setTimeout(hideBanner, 220);
    }

    try {
      window.sessionStorage.setItem(storageKey, "true");
    } catch {
      // Dismissing still works for the current page when storage is unavailable.
    }
  });
</script>
