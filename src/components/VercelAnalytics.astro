---
import Analytics from "@vercel/analytics/astro";

const locals = Astro.locals as { runtime?: { env?: Record<string, string | undefined> } };
const buildEnv = import.meta.env as Record<string, string | undefined>;
const isVercelBuild = locals.runtime?.env?.VERCEL === "1" || buildEnv.VERCEL === "1";
---

{isVercelBuild && <Analytics />}
