---
import Analytics from "@vercel/analytics/astro";
import { productionAnalyticsEnabled } from "../config/site";
import runtimePathScript from "../scripts/vercel-analytics-path.js?url";

const useRuntimePath = Astro.url.pathname === "/404" || Astro.url.pathname === "/404/";
---

{
  productionAnalyticsEnabled && useRuntimePath && (
    <script is:inline src={runtimePathScript}></script>
  )
}
{productionAnalyticsEnabled && <Analytics />}
