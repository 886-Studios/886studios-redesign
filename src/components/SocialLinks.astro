---
import { socialLinks } from "../data/siteContent";

interface Props {
  className?: string;
}

const { className = "socials" } = Astro.props;
---

<div class={className}>
  {
    socialLinks.map((link) => (
      <a class="social-btn" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.ariaLabel}>
        {link.platform === "x" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.901 1.153h3.68l-8.04 9.19 9.458 12.504H16.594l-5.8-7.584-6.64 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932L18.9 1.153Zm-1.291 19.492h2.04L6.486 3.24H4.298L17.61 20.645Z" />
          </svg>
        )}
        {link.platform === "instagram" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.8A3.95 3.95 0 0 0 3.8 7.75v8.5a3.95 3.95 0 0 0 3.95 3.95h8.5a3.95 3.95 0 0 0 3.95-3.95v-8.5a3.95 3.95 0 0 0-3.95-3.95h-8.5Zm8.95 1.35a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3ZM12 6.85A5.15 5.15 0 1 1 6.85 12 5.16 5.16 0 0 1 12 6.85Zm0 1.8A3.35 3.35 0 1 0 15.35 12 3.35 3.35 0 0 0 12 8.65Z" />
          </svg>
        )}
        {link.platform === "threads" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z" />
          </svg>
        )}
        {link.platform === "linkedin" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.98 3.5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5ZM3.5 8.5h2.96V20.5H3.5V8.5Zm5.28 0h2.84v1.64h.04c.4-.75 1.37-1.84 3.34-1.84 3.57 0 4.23 2.35 4.23 5.41v6.79h-2.96v-6.01c0-1.43-.03-3.27-1.99-3.27-2 0-2.31 1.56-2.31 3.17v6.11H8.78V8.5Z" />
          </svg>
        )}
        {link.platform === "discord" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.317 4.369A19.791 19.791 0 0 0 15.558 3c-.206.37-.444.87-.608 1.264a18.27 18.27 0 0 0-5.9 0A12.64 12.64 0 0 0 8.442 3a19.736 19.736 0 0 0-4.76 1.369C.673 8.874-.148 13.267.263 17.608a19.934 19.934 0 0 0 5.844 2.948c.47-.648.889-1.334 1.25-2.05a12.97 12.97 0 0 1-1.969-.95c.165-.123.326-.251.482-.383 3.798 1.781 7.92 1.781 11.673 0 .16.132.321.26.485.383-.625.366-1.282.685-1.972.95.361.716.779 1.402 1.25 2.05a19.887 19.887 0 0 0 5.847-2.948c.482-5.033-.822-9.385-3.836-13.239ZM8.02 14.973c-1.147 0-2.089-1.053-2.089-2.343 0-1.29.92-2.343 2.089-2.343 1.178 0 2.11 1.062 2.089 2.343 0 1.29-.921 2.343-2.089 2.343Zm7.96 0c-1.147 0-2.089-1.053-2.089-2.343 0-1.29.92-2.343 2.089-2.343 1.178 0 2.11 1.062 2.089 2.343 0 1.29-.911 2.343-2.089 2.343Z" />
          </svg>
        )}
        {link.platform === "substack" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 3h14v2H5V3Zm0 4h14v2H5V7Zm0 4h14v10.5l-7-3.9-7 3.9V11Z" />
          </svg>
        )}
      </a>
    ))
  }
</div>
