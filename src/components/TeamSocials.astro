---
import type { ProfileSocial } from "../data/partnerProfiles";
interface Props { socials?: ProfileSocial[]; align?: "center" | "start"; }
const { socials = [], align = "center" } = Astro.props;
---
  {socials.length > 0 && (
    <div class:list={["person-socials", align === "start" && "person-socials--start"]}>
      {socials.map((social) => (
        <a class={`social-link--${social.platform}`} href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.ariaLabel} title={social.ariaLabel}>
          {social.platform === "linkedin" ? (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.98 3.5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5ZM3.5 8.5h2.96V20.5H3.5V8.5Zm5.28 0h2.84v1.64h.04c.4-.75 1.37-1.84 3.34-1.84 3.57 0 4.23 2.35 4.23 5.41v6.79h-2.96v-6.01c0-1.43-.03-3.27-1.99-3.27-2 0-2.31 1.56-2.31 3.17v6.11H8.78V8.5Z" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.901 1.153h3.68l-8.04 9.19 9.458 12.504H16.594l-5.8-7.584-6.64 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932L18.9 1.153Zm-1.291 19.492h2.04L6.486 3.24H4.298L17.61 20.645Z" />
            </svg>
          )}
        </a>
      ))}
    </div>
  )}
<style>
  .person-socials { display: flex; justify-content: center; gap: 2px; margin-top: 4px; }
  .person-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--purple-bright);
    border-radius: 4px;
    transition: color .18s ease, background-color .18s ease;
  }
  .person-socials svg { width: 20px; height: 20px; fill: currentColor; }
  .person-socials .social-link--x svg { width: 16px; height: 16px; }
  .person-socials--start { justify-content: flex-start; }
  .person-socials a:is(:hover, :focus-visible) { color: var(--text-primary); background-color: color-mix(in srgb, var(--purple-bright) 12%, transparent); }
  .person-socials a:active { background-color: color-mix(in srgb, var(--purple-bright) 20%, transparent); }
  .person-socials a:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 5px; }
  @media (prefers-reduced-motion: reduce) { .person-socials a { transition: none; } }
</style>
