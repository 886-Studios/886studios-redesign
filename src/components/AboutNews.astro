---
import { siteContent } from "../data/siteContent";

const { resources } = siteContent;
const getNewsImageSrcset = (src: string) =>
  `${src.replace("-960.webp", "-480.webp")} 480w, ${src} 960w`;
---

<section class="about-news reveal reveal-delay-1" aria-labelledby="about-news-title">
  <h2 class="section-tag" id="about-news-title">In the News</h2>

  <div class="about-news-grid">
    {resources.newsItems.map((item) => (
      <article class="about-news-item">
        <a
          class="about-news-media"
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Read “${item.title}”`}
        >
          <img
            src={item.image.src}
            srcset={getNewsImageSrcset(item.image.src)}
            sizes="(max-width: 720px) calc(100vw - 36px), (max-width: 1180px) calc((100vw - 96px) / 2), 552px"
            alt={item.image.alt}
            width={item.image.width}
            height={item.image.height}
            loading="lazy"
            decoding="async"
          />
        </a>

        <div class="about-news-copy">
          <div class="about-news-meta">
            <p>{item.source}</p>
            {item.secondaryLink && (
              <a href={item.secondaryLink.href} target="_blank" rel="noopener noreferrer">
                {item.secondaryLink.label}
              </a>
            )}
          </div>
          <h3>
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              <span>{item.title}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5" />
              </svg>
            </a>
          </h3>
        </div>
      </article>
    ))}
  </div>
</section>
