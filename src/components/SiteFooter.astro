---
import SocialLinks from "./SocialLinks.astro";
import { brand, siteContent } from "../data/siteContent";

interface Props {
  hideSocials?: boolean;
}

const { hideSocials = false } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="footer-logo" href="/">
      <img src={brand.logoUrl} alt={brand.logoAlt} width={brand.logoWidth} height={brand.logoHeight} loading="lazy" decoding="async" />
    </a>
    <div class="footer-copy">
      <span>{siteContent.footer.copy}</span>
      <div class="footer-links">
        <a class="footer-link" href="/contact">Contact</a>
        <a class="footer-link" href="/privacy">Privacy</a>
      </div>
    </div>
    {!hideSocials && <SocialLinks />}
  </div>
</footer>
