---
interface Props {
  title: string;
  lead?: string;
  titleId?: string;
  titleHref?: string;
  titleLinkTarget?: "_blank" | "_self";
  className?: string;
  showDivider?: boolean;
  accentHeader?: boolean;
}

const {
  title,
  lead,
  titleId = "page-title",
  titleHref,
  titleLinkTarget = "_self",
  className,
  showDivider = true,
  accentHeader,
} = Astro.props;
---

<section class:list={["pg-hero", accentHeader && "accent-hero", accentHeader && title.length > 28 && "accent-hero--long", className]} aria-labelledby={titleId}>
  {!accentHeader && <div class="pg-hero-glow"></div>}
  <h1 class="section-h2 pg-hero-title" id={titleId}>
    {titleHref ? (
      <a
        class="pg-hero-title-link"
        href={titleHref}
        target={titleLinkTarget}
        rel={titleLinkTarget === "_blank" ? "noopener noreferrer" : undefined}
      >
        {title}
      </a>
    ) : (
      <slot name="title">{title}</slot>
    )}
  </h1>
  {lead && <p class="section-lead section-lead--flush">{lead}</p>}
  <slot />
</section>
{showDivider && <div class="pg-divider"></div>}

<style>
  .pg-hero.accent-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: end;
    padding-block: clamp(56px, 7vw, 88px) 56px;
  }

  .accent-hero .pg-hero-title {
    margin: 0;
    font-size: clamp(1.375rem, 5.6vw, var(--text-page-title-max));
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .accent-hero--long .pg-hero-title {
    font-size: clamp(1rem, 4.5vw, var(--text-page-title-max));
  }

  .accent-hero .section-lead {
    max-width: 65ch;
    line-height: 1.65;
  }

  .accent-hero :global(.draft-notice) {
    grid-column: 1 / -1;
    margin-top: 0;
  }

  @media (max-width: 760px) {
    .pg-hero.accent-hero {
      gap: 24px;
      padding-block: 52px 40px;
    }

    .accent-hero .section-lead {
      max-width: 44ch;
    }
  }
</style>
