---
import { blogConfig } from "../lib/substack";

interface Props {
  placement: string;
  analyticsPlacement?: string;
  showPublicationBrand?: boolean;
  contained?: boolean;
}

const {
  placement,
  analyticsPlacement = "blog_post",
  showPublicationBrand = false,
  contained = false,
} = Astro.props;
const safePlacement = placement.replace(/[^a-zA-Z0-9_-]/g, "");
const headingId = `article-subscribe-heading-${safePlacement}`;
const inputId = `article-subscribe-email-${safePlacement}`;
const frameName = `article-subscribe-frame-${safePlacement}`;
---

<section
  class:list={[
    "blog-post-subscribe",
    showPublicationBrand && "blog-post-subscribe--branded",
    contained && "blog-post-subscribe--contained",
  ]}
  aria-labelledby={headingId}
>
  {showPublicationBrand && (
    <img
      class="blog-post-subscribe-artwork"
      src={blogConfig.publicationImage}
      alt="ikigai Insights"
      width="1280"
      height="640"
      loading="lazy"
      decoding="async"
    />
  )}

  <div class="blog-post-subscribe-copy">
    <h2 id={headingId}>
      {contained ? blogConfig.publicationName : `Subscribe to ${blogConfig.publicationName}`}
    </h2>
    <p>{blogConfig.description}</p>
  </div>

  <form
    class="blog-post-subscribe-form"
    action={blogConfig.subscribeAction}
    method="post"
    target={frameName}
    data-article-subscribe
    data-analytics-event="newsletter_signup"
    data-analytics-placement={analyticsPlacement}
    data-analytics-label={blogConfig.publicationName}
  >
    <input type="hidden" name="source" value="website" />
    {contained && <p class="blog-post-subscribe-prompt">Subscribe to keep up with new stories.</p>}
    <div class="blog-post-subscribe-controls">
      <label class="sr-only" for={inputId}>Email address</label>
      <input
        id={inputId}
        type="email"
        name="email"
        placeholder="you@company.com"
        autocomplete="email"
        required
      />
      <button type="submit">Subscribe</button>
    </div>
    <p class="blog-post-subscribe-note" aria-live="polite">
      {blogConfig.subscriberNote}
    </p>
  </form>

  <iframe
    class="nl-frame"
    name={frameName}
    title="Newsletter signup status"
    sandbox="allow-forms allow-scripts"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-article-subscribe]").forEach((form) => {
    if (form.dataset.enhanced === "true") return;
    form.dataset.enhanced = "true";

    form.addEventListener("submit", () => {
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      const note = form.querySelector<HTMLElement>(".blog-post-subscribe-note");

      form.classList.add("is-submitted");
      if (button) button.textContent = "Check your inbox";
      if (note) note.textContent = "Almost there. Confirm your subscription from your inbox.";
    });
  });
</script>
