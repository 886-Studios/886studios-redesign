---
import { brand, siteContent } from "../data/siteContent";
import { partnerProfiles } from "../data/partnerProfiles";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isResidencyPage = currentPath === "/launch-station" || currentPath === "/programs/launch-station";
const navCta = isResidencyPage ? siteContent.programs.launchStation.joining.cta : siteContent.nav.cta;

const isActiveNavItem = (href: string) => {
  if (href === "/ikigai-launchpad") {
    return currentPath === href;
  }
  if (href === "/team" && partnerProfiles.some((profile) => currentPath === `/about/${profile.slug}`)) {
    return true;
  }
  return href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a class="nav-logo" href="/">
      <img src={brand.logoUrl} alt={brand.logoAlt} width={brand.logoWidth} height={brand.logoHeight} decoding="async" />
    </a>
    <div class="nav-links">
      {
        siteContent.nav.items.map((item) => item.children ? (
          <details class="nav-group" data-nav-group>
            <summary
              class:list={["nav-link", item.children.some((child) => isActiveNavItem(child.href)) && "active"]}
              aria-controls={`nav-drawer-${item.id}`}
            >
              {item.label}
              <svg class="nav-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <ul class="nav-submenu" id={`nav-drawer-${item.id}`}>
              {item.children.map((child) => (
                <li>
                  <a class:list={["nav-submenu-link", isActiveNavItem(child.href) && "active"]} href={child.href} aria-current={currentPath === child.href ? "page" : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a class:list={["nav-link", isActiveNavItem(item.href) && "active"]} href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>
    <a
      class="nav-cta nav-cta--desktop"
      href={navCta.href}
      target={isResidencyPage ? undefined : "_blank"}
      rel={isResidencyPage ? undefined : "noopener noreferrer"}
      data-analytics-event={isResidencyPage ? "program_interest" : "application_started"}
      data-analytics-label={isResidencyPage ? "launch_station" : undefined}
      data-analytics-placement="global_nav_desktop"
    >
      {navCta.label}
    </a>
    <button type="button" class="nav-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer-overlay"></div>
  <div class="mobile-drawer-panel" role="dialog" aria-modal="true" aria-label="Main menu">
    <div class="mobile-drawer-header">
      <a class="nav-logo" href="/">
        <img src={brand.logoUrl} alt={brand.logoAlt} width={brand.logoWidth} height={brand.logoHeight} decoding="async" />
      </a>
      <button type="button" class="mobile-drawer-close" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <nav class="mobile-drawer-nav" aria-label="Mobile navigation">
      {
        siteContent.nav.items.map((item) => item.children ? (
          <div class="mobile-nav-group">
            <h2 class="mobile-nav-group-label">{item.label}</h2>
            <ul class="mobile-nav-children">
              {item.children.map((child) => (
                <li>
                  <a class:list={["mobile-nav-link", isActiveNavItem(child.href) && "active"]} href={child.href} aria-current={currentPath === child.href ? "page" : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a class:list={["mobile-nav-link", isActiveNavItem(item.href) && "active"]} href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mobile-drawer-footer">
      <a
        class="btn-pri btn-pri--full"
        href={navCta.href}
        target={isResidencyPage ? undefined : "_blank"}
        rel={isResidencyPage ? undefined : "noopener noreferrer"}
        data-analytics-event={isResidencyPage ? "program_interest" : "application_started"}
        data-analytics-label={isResidencyPage ? "launch_station" : undefined}
        data-analytics-placement="global_nav_mobile"
      >
        {navCta.label}
      </a>
    </div>
  </div>
</div>
