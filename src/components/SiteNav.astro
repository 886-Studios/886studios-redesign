---
import { brand, siteContent } from "../data/siteContent";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<!-- ===================== NAV ===================== -->
<nav>
  <div class="nav-inner">
    <a class="nav-logo" href="/">
      <img src={brand.logoUrl} alt={brand.logoAlt} />
    </a>
    <div class="nav-links">
      {
        siteContent.nav.items.map((item) => (
          <a class:list={["nav-link", currentPath === item.href && "active"]} href={item.href}>
            {item.label}
          </a>
        ))
      }
    </div>
    <a class="nav-cta" href={siteContent.nav.cta.href} target="_blank">
      {siteContent.nav.cta.label}
    </a>
  </div>
</nav>
