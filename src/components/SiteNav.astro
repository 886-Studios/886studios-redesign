---
import { brand, siteContent } from "../data/siteContent";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActiveNavItem = (href: string) => href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="site-nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/">
      <img src={brand.logoUrl} alt={brand.logoAlt} width={brand.logoWidth} height={brand.logoHeight} decoding="async" />
    </a>
    <div class="nav-links">
      {
        siteContent.nav.items.map((item) => (
          <a class:list={["nav-link", isActiveNavItem(item.href) && "active"]} href={item.href} aria-current={isActiveNavItem(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>
    <a
      class="nav-cta nav-cta--desktop"
      href={siteContent.nav.cta.href}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-event="application_started"
      data-analytics-placement="global_nav_desktop"
    >
      {siteContent.nav.cta.label}
    </a>
    <button class="nav-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer-overlay"></div>
  <div class="mobile-drawer-panel" role="dialog" aria-modal="true" aria-label="Main menu">
    <div class="mobile-drawer-header">
      <a class="nav-logo" href="/">
        <img src={brand.logoUrl} alt={brand.logoAlt} width={brand.logoWidth} height={brand.logoHeight} decoding="async" />
      </a>
      <button class="mobile-drawer-close" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <nav class="mobile-drawer-nav">
      {
        siteContent.nav.items.map((item) => (
          <a class:list={["mobile-nav-link", isActiveNavItem(item.href) && "active"]} href={item.href} aria-current={isActiveNavItem(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mobile-drawer-footer">
      <a
        class="btn-pri btn-pri--full"
        href={siteContent.nav.cta.href}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="application_started"
        data-analytics-placement="global_nav_mobile"
      >
        {siteContent.nav.cta.label}
      </a>
    </div>
  </div>
</div>
