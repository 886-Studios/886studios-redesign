---
import type { ProfileSocial } from "../data/partnerProfiles";
import TeamCompanies from "./TeamCompanies.astro";
import TeamSocials from "./TeamSocials.astro";
import TeamPortrait from "./TeamPortrait.astro";
interface Props {
  name: string;
  photo: string;
  role?: string;
  company?: string;
  profileHref?: string;
  socials?: ProfileSocial[];
  eager?: boolean;
}
const { name, photo, role, company, profileHref, socials = [], eager = false } = Astro.props;
const ProfileLink = profileHref ? "a" : "div";
---

<article class="person">
  <ProfileLink class="person-profile" href={profileHref} aria-label={profileHref ? `View profile for ${name}` : undefined}>
    <TeamPortrait name={name} photo={photo} eager={eager} />
    <p class="team-person-role">{role}</p>
    <h3 class="person-name">{name}</h3>
  </ProfileLink>
  <TeamCompanies company={company} />
  <TeamSocials socials={socials} />
</article>

<style>
  .person {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    row-gap: 0;
    text-align: center;
    min-width: 0;
  }
  .person-profile {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0;
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
    min-width: 0;
  }
  .person-name { font-family: var(--font-display); font-size: 20px; font-weight: 700; line-height: 1.3; text-wrap: balance; transition: color 150ms ease-out; }
  .person-profile[href]:is(:focus-visible, :active) { --portrait-engaged: 1; }
  .person-profile[href]:is(:focus-visible, :active) .person-name { color: var(--purple-bright); }
  @media (hover: hover) and (pointer: fine) {
    .person-profile[href]:hover { --portrait-engaged: 1; }
    .person-profile[href]:hover .person-name { color: var(--purple-bright); }
  }
  .person-profile:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 5px; }
  @media (prefers-reduced-motion: reduce) {
    .person-name { transition: none; }
  }
  @media (max-width: 760px) {
    .person-name { font-size: 18px; }
  }
  @media (max-width: 440px) {
    .person-name { font-size: 17px; }
  }
</style>
