---
import type { ProfileSocial } from "../data/partnerProfiles";
import { teamCompanyLinks } from "../data/teamCompanyLinks";
import TeamPortrait from "./TeamPortrait.astro";
interface Props {
  name: string;
  photo: string;
  role?: string;
  company?: string;
  profileHref?: string;
  socials?: ProfileSocial[];
  eager?: boolean;
}
const { name, photo, role, company, profileHref, socials = [], eager = false } = Astro.props;
const ProfileLink = profileHref ? "a" : "div";
const companies = company?.split(" / ") ?? [];
---

<article class="person">
  <ProfileLink class="person-profile" href={profileHref} aria-label={profileHref ? `View profile for ${name}` : undefined}>
    <TeamPortrait name={name} photo={photo} eager={eager} />
    <p class="person-role">{role}</p>
    <h3 class="person-name">{name}</h3>
  </ProfileLink>
  <p class="person-company">
    {companies.map((label, index) => (
      <>
        {index > 0 && <span aria-hidden="true"> / </span>}
        {teamCompanyLinks[label] ? (
          <a href={teamCompanyLinks[label]} target="_blank" rel="noopener noreferrer">{label}</a>
        ) : label}
      </>
    ))}
  </p>
  {socials.length > 0 && (
    <div class="person-socials">
      {socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.ariaLabel} title={social.ariaLabel}>
          {social.platform === "linkedin" ? (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.98 3.5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5ZM3.5 8.5h2.96V20.5H3.5V8.5Zm5.28 0h2.84v1.64h.04c.4-.75 1.37-1.84 3.34-1.84 3.57 0 4.23 2.35 4.23 5.41v6.79h-2.96v-6.01c0-1.43-.03-3.27-1.99-3.27-2 0-2.31 1.56-2.31 3.17v6.11H8.78V8.5Z" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.901 1.153h3.68l-8.04 9.19 9.458 12.504H16.594l-5.8-7.584-6.64 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932L18.9 1.153Zm-1.291 19.492h2.04L6.486 3.24H4.298L17.61 20.645Z" />
            </svg>
          )}
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .person {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    row-gap: 0;
    text-align: center;
    min-width: 0;
  }
  .person-profile {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 0;
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
    min-width: 0;
  }
  .person-role {
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .person-role:empty { margin: 0; }
  .person-name { font-family: var(--font-display); font-size: 20px; font-weight: 700; line-height: 1.3; }
  .person-company { color: var(--purple-bright); font-size: 14px; line-height: 1.5; margin-top: 4px; }
  .person-company a { color: inherit; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; }
  .person-company a:hover { color: var(--text-primary); text-decoration-color: currentColor; }
  .person-socials { display: flex; justify-content: center; gap: 2px; margin-top: 4px; }
  .person-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--purple-bright);
    border-radius: 4px;
    transition: color .18s ease;
  }
  .person-socials svg { width: 20px; height: 20px; fill: currentColor; }
  .person-profile[href]:hover .person-name, .person-socials a:hover { color: var(--purple-bright); }
  .person-socials a:hover { color: var(--text-primary); }
  .person-profile:focus-visible, .person-company a:focus-visible, .person-socials a:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 5px; }
  @media (max-width: 760px) {
    .person-name { font-size: 18px; }
    .person-company { font-size: 13px; }
  }
  @media (max-width: 440px) {
    .person-name { font-size: 17px; }
    .person-company { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .person-socials a { transition: none; } }
</style>
