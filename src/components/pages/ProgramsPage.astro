---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
const [ikigai, launchStation] = programs.items;

const applicationSteps = [
  "Apply",
  "Review",
  "886 interview",
  "Lifelike interview",
];

const programPhotos = {
  hero: {
    src: "/assets/programs/ikigai-founder-table.jpeg",
    alt: "ikigai Launchpad founders working together around a table",
  },
  funding: {
    src: "/assets/programs/ikigai-storytelling-room.jpeg",
    alt: "Founders in an ikigai Launchpad workshop",
  },
  community: {
    src: "/assets/programs/ikigai-launch-station.jpeg",
    alt: "ikigai Launchpad founders gathered for a cohort photo",
  },
  support: {
    src: "/assets/programs/ikigai-mentor-session.jpeg",
    alt: "A mentor session with founders around a table",
  },
  launchStation: {
    src: "/assets/programs/ikigai-batch-discussion.jpeg",
    alt: "Founders gathered for a group discussion",
  },
};

const ikigaiPillars = [
  {
    title: "Funding",
    kicker: "Capital to focus",
    image: programPhotos.funding,
    reversed: false,
    details: [
      { label: "Investment", value: "$100K USD" },
      { label: "Purpose", value: "Work full-time on the company" },
    ],
  },
  {
    title: "Hands-on support",
    kicker: "Weekly founder time",
    image: programPhotos.support,
    reversed: true,
    details: [
      { label: "Mentor office hours", value: "Weekly 1-on-1 time" },
      { label: "Investor access", value: "Warm intros and matching" },
      { label: "After the batch", value: "Support beyond 12 weeks" },
    ],
  },
  {
    title: "Community",
    kicker: "In person in Taipei",
    image: programPhotos.community,
    reversed: false,
    details: [
      { label: "Format", value: "12 weeks in person" },
      { label: "Location", value: "Taipei" },
      { label: "Batch", value: "Founders building together" },
    ],
  },
];

const launchStationHighlights = ["Free workspace", "Founder community"];
---

<div class="page" id="page-programs">
  <section class="program-page-hero" aria-labelledby="programs-title">
    <div class="program-hero-copy">
      <div class="section-tag">Accelerator program</div>
      <h1 class="program-headline" id="programs-title">{ikigai.name}</h1>
      <p class="program-summary">{programs.lead}</p>
      <div class="program-hero-facts" role="list">
        {ikigai.details?.metrics.map((metric) => (
          <div class="program-hero-fact" role="listitem">
            <span class="program-hero-fact-value">{metric.value}</span>
            <span class="program-hero-fact-label">{metric.label}</span>
          </div>
        ))}
      </div>
      <div class="program-hero-actions">
        <a class="btn-pri program-primary-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
      </div>
    </div>
    <figure class="program-hero-image">
      <img src={programPhotos.hero.src} alt={programPhotos.hero.alt} decoding="async" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <main class="program-page-body">
    <div class="program-pillar-list">
      {ikigaiPillars.map((pillar, index) => (
        <article class:list={["program-pillar-chapter reveal", pillar.reversed && "is-reversed"]}>
          <div class="program-pillar-copy">
            <span class="program-pillar-index">{String(index + 1).padStart(2, "0")}</span>
            <p class="program-pillar-kicker">{pillar.kicker}</p>
            <h2>{pillar.title}</h2>
          </div>
          <figure class="program-pillar-image">
            <img src={pillar.image.src} alt={pillar.image.alt} decoding="async" />
          </figure>
          <dl class="program-pillar-details">
            {pillar.details.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>{detail.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>

    <hr class="divider program-section-divider" />

    <section class="program-conversion reveal" aria-label="Apply to ikigai Launchpad">
      <div class="program-apply-copy">
        <span class="program-band-label">Applications</span>
        <h2>Apply to ikigai Launchpad.</h2>
        <a class="btn-pri program-primary-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
      </div>
      <div class="program-process-compact" aria-labelledby="program-process-title">
        <h3 id="program-process-title">What happens after you apply</h3>
        <ol class="program-process-list">
          {applicationSteps.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              {step}
            </li>
          ))}
        </ol>
      </div>
    </section>

    {launchStation && (
      <section class="program-secondary reveal" aria-labelledby="launch-station-title">
        <div class="program-secondary-copy">
          <span class="program-band-label">{launchStation.track}</span>
          <h2 id="launch-station-title">{launchStation.name}</h2>
          <p>{launchStation.body}</p>
          <dl class="program-secondary-list">
            {launchStationHighlights.map((highlight) => (
              <div>
                <dt>{highlight}</dt>
              </div>
            ))}
          </dl>
          <div class="program-status">{launchStation.cta.label}</div>
        </div>
        <figure class="program-secondary-image">
          <img src={programPhotos.launchStation.src} alt={programPhotos.launchStation.alt} decoding="async" />
        </figure>
      </section>
    )}
  </main>
</div>
