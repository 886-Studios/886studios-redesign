---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
const [ikigai] = programs.items;

const applicationSteps = [
  "Submit application",
  "Application review",
  "Interview with 886 Studios",
  "Interview with Lifelike Capital",
];

const partnerProof = ["Twitch", "Guitar Hero", "Kabam", "Playdom"];
---

<div class="page" id="page-programs">
  <section class="program-page-hero" aria-labelledby="programs-title">
    <div class="program-hero-copy">
      <div class="section-tag">Accelerator program</div>
      <p class="program-hero-kicker">886 Studios in Taipei</p>
      <h1 class="program-headline" id="programs-title">{ikigai.name}</h1>
      <p class="program-summary">{programs.lead}</p>
      <div class="program-hero-actions">
        <a class="btn-pri program-primary-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
        <a class="card-cta program-secondary-link" href="#ikigai-details">Read the program brief</a>
      </div>
    </div>

    <aside class="program-application-panel" aria-label="ikigai Launchpad program facts">
      <div class="program-panel-label">Quick facts</div>
      <p class="program-panel-copy">{ikigai.fit}</p>
      <dl class="program-fact-list">
        {ikigai.details?.metrics.map((metric) => (
          <div class="program-fact">
            <dt>{metric.label}</dt>
            <dd>{metric.value}</dd>
            <span>{metric.note}</span>
          </div>
        ))}
      </dl>
    </aside>
  </section>

  <main class="program-page-body">
    <section class="program-proof-strip" aria-label="886 Studios partner context">
      <p>Built by 886 Studios partners behind</p>
      <div>
        {partnerProof.map((partner) => <span>{partner}</span>)}
      </div>
    </section>

    <section class="program-brief" id="ikigai-details" aria-labelledby="ikigai-details-title">
      <div class="program-brief-intro">
        <div class="section-tag">Core pillars</div>
        <h2 id="ikigai-details-title">Funding, community, and hands-on support.</h2>
        <p>{ikigai.body}</p>
      </div>

      <div class="program-brief-grid">
        {ikigai.details?.sections.map((section) => (
          <article class="program-brief-block">
            <h3>{section.title}</h3>
            <ul>
              {section.items.map((detail) => <li>{detail}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="program-process" aria-labelledby="program-process-title">
      <div>
        <span class="program-band-label">Application process</span>
        <h2 id="program-process-title">What happens after you apply</h2>
      </div>
      <ol class="program-process-list">
        {applicationSteps.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="program-apply-band" aria-label="Apply to ikigai Launchpad">
      <div>
        <span class="program-band-label">Applications</span>
        <h2>Apply to ikigai Launchpad.</h2>
      </div>
      <p>
        Apply if you are ready for 12 weeks in person in Taipei, weekly mentor office hours, investor introductions,
        and support beyond the batch.
      </p>
      <a class="btn-pri program-primary-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
        Apply to ikigai Launchpad
      </a>
    </section>
  </main>
</div>
