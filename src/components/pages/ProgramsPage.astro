---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
const [ikigai, launchStation] = programs.items;

const applicationSteps = ["Apply", "Review", "886 interview", "Lifelike interview"];
const nextBatch = "Next batch starts Fall 2026.";

const heroPhoto = {
  src: "/assets/programs/ikigai-workshop-room.jpeg",
  alt: "ikigai Launchpad workshop session with founders",
};

const launchStationPhoto = {
  src: "/assets/programs/ikigai-batch-discussion.jpeg",
  alt: "Founders gathered at Launch Station",
};

const specPillars = [
  {
    title: "Funding",
    headline: "$100K to build full time",
    proofPoints: [
      "$100K USD investment",
      "12 weeks focused on the company",
      "For founders ready to work full time",
    ],
    photo: {
      src: "/assets/programs/ikigai-founder-table.jpeg",
      alt: "Founders working together during ikigai Launchpad",
    },
  },
  {
    title: "Hands-on support",
    headline: "Weekly support from operators",
    proofPoints: [
      "1-on-1 mentor office hours",
      "Founder-led workshops",
      "Warm intros and investor matching",
    ],
    photo: {
      src: "/assets/programs/ikigai-mentor-session.jpeg",
      alt: "ikigai Launchpad mentor session with founders",
    },
  },
  {
    title: "Community",
    headline: "A founder batch in Taipei",
    proofPoints: [
      "In person in Taipei",
      "Founders building alongside each other",
      "Support beyond the batch",
    ],
    photo: {
      src: "/assets/programs/ikigai-group-tshirts.jpeg",
      alt: "ikigai Launchpad founders together in Taipei",
    },
  },
];
---

<div class="page" id="page-programs">

  <!-- Hero: ikigai brand + key info + photo -->
  <section class="prog-hero" aria-labelledby="prog-ikigai-heading">
    <div class="prog-hero-copy">
      <div class="prog-brand-row">
        <img class="prog-mark" src="/assets/programs/ikigai-mark.png" alt="" aria-hidden="true" />
      </div>
      <h1 class="prog-h1" id="prog-ikigai-heading">{ikigai.name}</h1>
      <p class="prog-lead">{programs.lead}</p>
      <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
        Apply to ikigai Launchpad
      </a>
      <p class="prog-next-batch">{nextBatch}</p>
    </div>
    <figure class="prog-hero-photo">
      <img src={heroPhoto.src} alt={heroPhoto.alt} decoding="async" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <div class="prog-body">

    <!-- Pillars: what the program gives you -->
    <section class="prog-pillars reveal" aria-label="What ikigai Launchpad includes">
      {specPillars.map((p) => (
        <article class="prog-pillar-card">
          <figure class="prog-pillar-media">
            <img src={p.photo.src} alt={p.photo.alt} decoding="async" loading="eager" />
          </figure>
          <div class="prog-pillar-copy">
            <p class="prog-pillar-label">{p.title}</p>
            <h3 class="prog-spec-name">{p.headline}</h3>
            <ul class="prog-proof-list" aria-label={`${p.title} proof points`}>
              {p.proofPoints.map((point) => (
                <li class="prog-proof-item">{point}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </section>

    <!-- Apply: CTA + process steps -->
    <section class="prog-apply reveal" aria-label="Apply to ikigai Launchpad">
      <div class="prog-apply-copy">
        <span class="prog-band-label">Applications</span>
        <h2 class="prog-apply-h2">Apply to ikigai<br/>Launchpad.</h2>
        <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
        <p class="prog-next-batch prog-next-batch--apply">{nextBatch}</p>
      </div>
      <div class="prog-process" aria-labelledby="prog-process-lbl">
        <h3 class="prog-process-lbl" id="prog-process-lbl">What happens after you apply</h3>
        <ol class="prog-process-list">
          {applicationSteps.map((step, i) => (
            <li class="prog-process-item">
              <span class="prog-process-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="prog-process-step">{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Launch Station: secondary program -->
    {launchStation && (
      <section class="prog-launch reveal" aria-labelledby="prog-launch-heading">
        <div class="prog-launch-copy">
          <span class="prog-band-label">{launchStation.track}</span>
          <h2 class="prog-launch-name" id="prog-launch-heading">{launchStation.name}</h2>
          <p class="prog-launch-body">{launchStation.body}</p>
          <ul class="prog-launch-highlights">
            <li>Free workspace</li>
            <li>Founder community</li>
          </ul>
          <span class="prog-launch-status">{launchStation.cta.label}</span>
        </div>
        <figure class="prog-launch-photo">
          <img src={launchStationPhoto.src} alt={launchStationPhoto.alt} decoding="async" />
        </figure>
      </section>
    )}

  </div>
</div>
