---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
const [ikigai, launchStation] = programs.items;
const launchStationHref =
  launchStation?.cta.type === "link" && "href" in launchStation.cta ? launchStation.cta.href : undefined;

const applicationSteps = [
  {
    title: "Submit Application",
  },
  {
    title: "Application Review",
  },
  {
    title: "1st Interview",
  },
  {
    title: "2nd Interview",
  },
];
const nextBatch = "Next batch starts Fall 2026.";
const quickFacts = ikigai.details?.metrics ?? [];
const ikigaiNameParts = ikigai.name.split(" ");
const founderBenefitsIntro =
  "ikigai Launchpad gives founders capital, operator access, working space, and a real Taipei batch. These are the core pieces teams use across the 10 weeks and beyond.";
const pillarImageWidths = [640, 960, 1280];
const pillarImageSizes =
  "(max-width: 640px) calc(100vw - 36px), (max-width: 980px) calc((100vw - 48px - 18px) / 2), 371px";

const getPillarPhoto = (
  name: string,
  alt: string,
  dimensions: { width: number; height: number }
) => ({
  alt,
  width: dimensions.width,
  height: dimensions.height,
  sizes: pillarImageSizes,
  src: `/assets/programs/${name}-960.jpg`,
  avifSrcset: pillarImageWidths.map((width) => `/assets/programs/${name}-${width}.avif ${width}w`).join(", "),
  webpSrcset: pillarImageWidths.map((width) => `/assets/programs/${name}-${width}.webp ${width}w`).join(", "),
  jpgSrcset: pillarImageWidths.map((width) => `/assets/programs/${name}-${width}.jpg ${width}w`).join(", "),
});

const heroPhoto = {
  src: "/assets/programs/ikigai-audience-theater-1280.webp",
  srcset:
    "/assets/programs/ikigai-audience-theater-1280.webp 1280w, /assets/programs/ikigai-audience-theater-1920.webp 1920w",
  sizes: "(max-width: 640px) calc(100vw - 36px), min(calc(100vw - 48px), 1160px)",
  alt: "ikigai Launchpad audience gathered in a theater",
};

const launchStationPhoto = {
  src: programs.launchStation.poster.src,
  alt: programs.launchStation.poster.alt,
};

const specPillars = [
  {
    title: "Funding",
    headline: "$100,000 USD",
    proofPoints: [
      "$100,000 USD funding through a SAFE note",
      "Quit your job and focus full-time on building",
      "Potential follow-on investment from Lifelike Capital",
    ],
    photo: getPillarPhoto("ikigai-founder-table", "Founders working together during ikigai Launchpad", {
      width: 1280,
      height: 960,
    }),
  },
  {
    title: "Hands-on support",
    headline: "1-on-1 Weekly Mentor Office Hours",
    proofPoints: [
      "Founder-Led Workshops",
      "Guest Speakers",
      "Warm Introductions + Investor Matching",
      "Exclusive Corporate Perks",
    ],
    photo: getPillarPhoto("ikigai-mentor-session", "ikigai Launchpad mentor session with founders", {
      width: 1280,
      height: 960,
    }),
  },
  {
    title: "Community",
    headline: "Work alongside other founders",
    proofPoints: [
      "Free Office Space in Taipei",
      "Team Building",
      "Networking & Founder Events",
      "Support beyond the 10-week timeframe",
    ],
    photo: getPillarPhoto("ikigai-group-tshirts", "ikigai Launchpad founders together in Taipei", {
      width: 1280,
      height: 1707,
    }),
  },
];
---

<div class="page" id="page-programs">

  <section class="prog-hero" aria-labelledby="prog-ikigai-heading">
    <div class="prog-hero-copy">
      <h1 class="prog-h1" id="prog-ikigai-heading">
        {ikigaiNameParts.map((part, index) => (
          <>
            {index > 0 && <br />}
            <span>{part}</span>
          </>
        ))}
      </h1>
      <p class="prog-lead">{programs.lead}</p>
      <div class="prog-hero-actions">
        <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
        <p class="prog-next-batch">{nextBatch}</p>
      </div>
    </div>
    <aside class="prog-brief-card" aria-label="ikigai Launchpad facts">
      <dl class="prog-brief-facts">
        {quickFacts.map((fact) => (
          <div class="prog-brief-fact">
            <dt>{fact.label}</dt>
            <dd>
              <strong>{fact.value}</strong>
              {fact.note && <span>{fact.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </aside>
  </section>

  <section class="prog-media" aria-label="ikigai Launchpad in session">
    <figure class="prog-hero-photo">
      <img
        src={heroPhoto.src}
        srcset={heroPhoto.srcset}
        sizes={heroPhoto.sizes}
        alt={heroPhoto.alt}
        width="1920"
        height="1280"
        decoding="async"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <div class="prog-body">
    <section class="prog-pillars reveal" aria-labelledby="prog-includes-heading">
      <header class="prog-section-header">
        <div class="prog-section-heading">
          <h2 class="prog-section-title" id="prog-includes-heading">What founders get</h2>
        </div>
        <p class="prog-section-copy">{founderBenefitsIntro}</p>
      </header>
      <div class="prog-pillar-grid">
        {specPillars.map((p) => (
          <article class="prog-pillar-card">
            <figure class="prog-pillar-media">
              <picture>
                <source type="image/avif" srcset={p.photo.avifSrcset} sizes={p.photo.sizes} />
                <source type="image/webp" srcset={p.photo.webpSrcset} sizes={p.photo.sizes} />
                <img
                  src={p.photo.src}
                  srcset={p.photo.jpgSrcset}
                  sizes={p.photo.sizes}
                  alt={p.photo.alt}
                  width={p.photo.width}
                  height={p.photo.height}
                  decoding="async"
                  loading="lazy"
                />
              </picture>
            </figure>
            <div class="prog-pillar-copy">
              <p class="prog-pillar-label">{p.title}</p>
              <h3 class="prog-spec-name">{p.headline}</h3>
              <ul class="prog-proof-list" aria-label={`${p.title} proof points`}>
                {p.proofPoints.map((point) => (
                  <li class="prog-proof-item">{point}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="prog-apply reveal" id="prog-apply" aria-label="Apply to ikigai Launchpad">
      <div class="prog-apply-copy">
        <span class="prog-band-label">Applications</span>
        <h2 class="prog-apply-h2">Apply to ikigai Launchpad.</h2>
        <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
        <p class="prog-next-batch prog-next-batch--apply">{nextBatch}</p>
      </div>
      <div class="prog-process-card" aria-labelledby="prog-process-lbl">
        <h3 class="prog-process-lbl" id="prog-process-lbl">Timeline</h3>
        <ol class="prog-process-list">
          {applicationSteps.map((step, index) => (
            <li class="prog-process-item">
              <span class="prog-process-num">{index + 1}</span>
              <span class="prog-process-step-wrap">
                <span class="prog-process-step">{step.title}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {launchStation && launchStationHref && (
      <a class="prog-launch reveal" aria-labelledby="prog-launch-heading" href={launchStationHref}>
        <figure class="prog-launch-photo">
          <img
            src={launchStationPhoto.src}
            alt={launchStationPhoto.alt}
            width={programs.launchStation.poster.width}
            height={programs.launchStation.poster.height}
            decoding="async"
            loading="lazy"
          />
        </figure>
        <div class="prog-launch-copy">
          <span class="prog-band-label">Also available</span>
          <h2 class="prog-launch-name" id="prog-launch-heading">{launchStation.name}</h2>
          <p class="prog-launch-body">
            Free desk inside{" "}
            <span class="prog-inline-link prog-inline-link--static">
              Taiwan Tech Arena
            </span>{" "}
            for founders who build better around other ambitious peers.
          </p>
          <ul class="prog-launch-highlights">
            {launchStation.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <span class="prog-launch-status">{launchStation.cta.label}</span>
        </div>
      </a>
    )}

  </div>
</div>
