---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
const [ikigai, launchStation] = programs.items;

const applicationSteps = [
  "Submit application",
  "Application review",
  "Interview with 886 Studios",
  "Interview with Lifelike Capital",
];

const programPhotos = {
  feature: {
    src: "/assets/programs/ikigai-founder-table.jpeg",
    alt: "Founders working together around a table in Taipei",
  },
  launchStation: {
    src: "/assets/programs/ikigai-batch-discussion.jpeg",
    alt: "Founders gathered for a group discussion",
  },
};

const launchStationDetails = [
  {
    label: "Free workspace",
    note: "A Taipei base inside Taiwan Tech Arena.",
  },
  {
    label: "Founder community",
    note: "Built for useful collisions with other ambitious teams.",
  },
];
---

<div class="page" id="page-programs">
  <section class="program-page-hero" aria-labelledby="programs-title">
    <div class="program-hero-copy">
      <div class="section-tag">Accelerator program</div>
      <h1 class="program-headline" id="programs-title">{ikigai.name}</h1>
      <p class="program-summary">{programs.lead}</p>
      <div class="program-hero-actions">
        <a class="btn-pri program-primary-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
      </div>
    </div>
  </section>

  <section class="program-facts-band" aria-label="ikigai Launchpad key facts">
    <dl class="program-fact-list">
      {ikigai.details?.metrics.map((metric) => (
        <div class="program-fact">
          <dt>{metric.label}</dt>
          <dd>{metric.value}</dd>
          <span>{metric.note}</span>
        </div>
      ))}
    </dl>
  </section>

  <figure class="program-feature-image">
    <img src={programPhotos.feature.src} alt={programPhotos.feature.alt} decoding="async" />
  </figure>

  <main class="program-page-body">
    <section class="program-pillars" id="ikigai-details" aria-labelledby="ikigai-details-title">
      <div class="program-pillars-intro">
        <div class="section-tag">{ikigai.name}</div>
        <h2 id="ikigai-details-title">Capital, a focused batch, and direct founder support.</h2>
        <p>{ikigai.body}</p>
      </div>

      <div class="program-pillar-list">
        {ikigai.details?.sections.map((section) => (
          <article class="program-pillar-row">
            <div class="program-pillar-copy">
              <h3>{section.title}</h3>
              <ul>
                {section.items.map((detail) => <li>{detail}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    {launchStation && (
      <section class="program-secondary" aria-labelledby="launch-station-title">
        <div class="program-secondary-copy">
          <span class="program-band-label">{launchStation.track}</span>
          <h2 id="launch-station-title">{launchStation.name}</h2>
          <p>{launchStation.body}</p>
          <dl class="program-secondary-list">
            {launchStationDetails.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>{detail.note}</dd>
              </div>
            ))}
          </dl>
          <div class="program-status">{launchStation.cta.label}</div>
        </div>
        <figure class="program-secondary-image">
          <img src={programPhotos.launchStation.src} alt={programPhotos.launchStation.alt} decoding="async" />
        </figure>
      </section>
    )}

    <section class="program-conversion" aria-label="Apply to ikigai Launchpad">
      <div class="program-apply-copy">
        <span class="program-band-label">Applications</span>
        <h2>Apply to ikigai Launchpad.</h2>
        <p>
          Apply if you are ready for 12 weeks in person in Taipei, weekly mentor office hours, investor introductions,
          and support beyond the batch.
        </p>
        <a class="btn-pri program-primary-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
      </div>
      <div class="program-process-compact" aria-labelledby="program-process-title">
        <h3 id="program-process-title">What happens after you apply</h3>
        <ol class="program-process-list">
          {applicationSteps.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </section>
  </main>
</div>
