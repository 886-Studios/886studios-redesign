---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
const [ikigai, launchStation] = programs.items;
const launchStationHref =
  launchStation?.cta.type === "link" && "href" in launchStation.cta ? launchStation.cta.href : undefined;

const applicationSteps = [
  {
    title: "Apply",
    detail: "Send us the basics on your company, team, and what you are building.",
  },
  {
    title: "Review",
    detail: "The 886 team looks for founder momentum, market insight, and fit for the batch.",
  },
  {
    title: "886 interview",
    detail: "Meet with our team to dig into your product, customer, and next milestones.",
  },
  {
    title: "Lifelike interview",
    detail: "Final conversation with our Launchpad partners before batch decisions.",
  },
];
const nextBatch = "Next batch starts Fall 2026.";
const quickFacts = ikigai.details?.metrics ?? [];
const ikigaiNameParts = ikigai.name.split(" ");
const taiwanTechArenaUrl = "https://www.taiwanarena.tech";
const founderBenefitsIntro =
  "ikigai Launchpad gives founders capital, weekly operator support, investor access, and a focused in-person batch in Taipei. The program is built for teams ready to spend 12 weeks moving faster on the company.";

const heroPhoto = {
  src: "/assets/programs/ikigai-workshop-room.jpeg",
  alt: "ikigai Launchpad workshop session with founders",
};

const launchStationPhoto = {
  src: programs.launchStation.poster.src,
  alt: programs.launchStation.poster.alt,
};

const specPillars = [
  {
    title: "Funding",
    headline: "$100K to focus full time",
    proofPoints: [
      "$100K USD for the company",
      "12-week in-person Taipei batch",
      "Full-time founder commitment",
    ],
    photo: {
      src: "/assets/programs/ikigai-founder-table.jpeg",
      alt: "Founders working together during ikigai Launchpad",
    },
  },
  {
    title: "Hands-on support",
    headline: "Weekly support from operators",
    proofPoints: [
      "Weekly mentor office hours",
      "Operator-led workshops",
      "Investor matching and warm intros",
    ],
    photo: {
      src: "/assets/programs/ikigai-mentor-session.jpeg",
      alt: "ikigai Launchpad mentor session with founders",
    },
  },
  {
    title: "Community",
    headline: "A focused founder batch in Taipei",
    proofPoints: [
      "In-person founder batch in Taipei",
      "Peer founders building with you",
      "Support after the batch",
    ],
    photo: {
      src: "/assets/programs/ikigai-group-tshirts.jpeg",
      alt: "ikigai Launchpad founders together in Taipei",
    },
  },
];
---

<div class="page" id="page-programs">

  <section class="prog-hero" aria-labelledby="prog-ikigai-heading">
    <div class="prog-hero-copy">
      <div class="prog-brand-row">
        <img class="prog-mark" src="/assets/programs/ikigai-mark.png" alt="" aria-hidden="true" />
        <span class="prog-band-label">{programs.eyebrow}</span>
      </div>
      <h1 class="prog-h1" id="prog-ikigai-heading">
        {ikigaiNameParts.map((part, index) => (
          <>
            {index > 0 && <br />}
            <span>{part}</span>
          </>
        ))}
      </h1>
      <p class="prog-lead">{programs.lead}</p>
      <div class="prog-hero-actions">
        <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
        <p class="prog-next-batch">{nextBatch}</p>
      </div>
    </div>
    <aside class="prog-brief-card" aria-label="ikigai Launchpad at a glance">
      <span class="prog-card-kicker">At a glance</span>
      <dl class="prog-brief-facts">
        {quickFacts.map((fact) => (
          <div class="prog-brief-fact">
            <dt>{fact.label}</dt>
            <dd>
              <strong>{fact.value}</strong>
              <span>
                {fact.note === "Built around Taiwan Tech Arena." ? (
                  <>
                    Built around{" "}
                    <a class="prog-inline-link" href={taiwanTechArenaUrl} target="_blank" rel="noopener noreferrer">
                      Taiwan Tech Arena
                    </a>.
                  </>
                ) : (
                  fact.note
                )}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    </aside>
  </section>

  <section class="prog-media reveal" aria-label="ikigai Launchpad in session">
    <figure class="prog-hero-photo">
      <img src={heroPhoto.src} alt={heroPhoto.alt} decoding="async" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <div class="prog-body">
    <section class="prog-pillars reveal" aria-labelledby="prog-includes-heading">
      <header class="prog-section-header">
        <div class="prog-section-heading">
          <span class="prog-band-label">ikigai Launchpad</span>
          <h2 class="prog-section-title" id="prog-includes-heading">What founders get</h2>
        </div>
        <p class="prog-section-copy">{founderBenefitsIntro}</p>
      </header>
      <div class="prog-pillar-grid">
        {specPillars.map((p) => (
          <article class="prog-pillar-card">
            <figure class="prog-pillar-media">
              <img src={p.photo.src} alt={p.photo.alt} decoding="async" loading="lazy" />
            </figure>
            <div class="prog-pillar-copy">
              <p class="prog-pillar-label">{p.title}</p>
              <h3 class="prog-spec-name">{p.headline}</h3>
              <ul class="prog-proof-list" aria-label={`${p.title} proof points`}>
                {p.proofPoints.map((point) => (
                  <li class="prog-proof-item">{point}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="prog-apply reveal" aria-label="Apply to ikigai Launchpad">
      <div class="prog-apply-copy">
        <span class="prog-band-label">Applications</span>
        <h2 class="prog-apply-h2">Apply to ikigai Launchpad.</h2>
        <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
        <p class="prog-next-batch prog-next-batch--apply">{nextBatch}</p>
      </div>
      <div class="prog-process-card" aria-labelledby="prog-process-lbl">
        <h3 class="prog-process-lbl" id="prog-process-lbl">What happens after you apply</h3>
        <ol class="prog-process-list">
          {applicationSteps.map((step, index) => (
            <li class="prog-process-item">
              <span class="prog-process-num">{index + 1}</span>
              <span class="prog-process-step-wrap">
                <span class="prog-process-step">{step.title}</span>
                <span class="prog-process-detail">{step.detail}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {launchStation && launchStationHref && (
      <a class="prog-launch reveal" aria-labelledby="prog-launch-heading" href={launchStationHref}>
        <figure class="prog-launch-photo">
          <img src={launchStationPhoto.src} alt={launchStationPhoto.alt} decoding="async" loading="lazy" />
        </figure>
        <div class="prog-launch-copy">
          <span class="prog-band-label">Also available</span>
          <h2 class="prog-launch-name" id="prog-launch-heading">{launchStation.name}</h2>
          <p class="prog-launch-body">
            Free workspace inside{" "}
            <a class="prog-inline-link" href={taiwanTechArenaUrl} target="_blank" rel="noopener noreferrer">
              Taiwan Tech Arena
            </a>{" "}
            for founders who build better around other ambitious teams.
          </p>
          <ul class="prog-launch-highlights">
            {launchStation.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <span class="prog-launch-status">{launchStation.cta.label}</span>
        </div>
      </a>
    )}

  </div>
</div>
