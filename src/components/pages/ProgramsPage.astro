---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
const [ikigai, launchStation] = programs.items;

const applicationSteps = ["Apply", "Review", "886 interview", "Lifelike interview"];

const heroPhoto = {
  src: "/assets/programs/ikigai-workshop-room.jpeg",
  alt: "ikigai Launchpad workshop session with founders",
};

const mosaicPhotos = [
  {
    src: "/assets/programs/ikigai-group-tshirts.jpeg",
    alt: "ikigai Launchpad founders in program t-shirts",
    portrait: true,
  },
  {
    src: "/assets/programs/ikigai-cowork-table.jpeg",
    alt: "Founders collaborating at a coworking space",
    portrait: false,
  },
  {
    src: "/assets/programs/ikigai-mentor-table.jpeg",
    alt: "Mentor session with founders at a long table",
    portrait: false,
  },
];

const launchStationPhoto = {
  src: "/assets/programs/ikigai-batch-discussion.jpeg",
  alt: "Founders gathered at Launch Station",
};

const specPillars = [
  {
    index: "01",
    title: "Funding",
    kicker: "Capital to focus",
    details: [
      { label: "Investment", value: "$100K USD" },
      { label: "Purpose", value: "Work full-time on the company" },
    ],
  },
  {
    index: "02",
    title: "Hands-on support",
    kicker: "Weekly founder time",
    details: [
      { label: "Mentor office hours", value: "Weekly 1-on-1 time" },
      { label: "Investor access", value: "Warm intros and matching" },
      { label: "After the batch", value: "Support beyond 12 weeks" },
    ],
  },
  {
    index: "03",
    title: "Community",
    kicker: "In person in Taipei",
    details: [
      { label: "Format", value: "12 weeks in person" },
      { label: "Location", value: "Taipei" },
      { label: "Batch", value: "Founders building together" },
    ],
  },
];
---

<div class="page" id="page-programs">

  <!-- Hero: ikigai brand + key info + photo -->
  <section class="prog-hero" aria-labelledby="prog-ikigai-heading">
    <div class="prog-hero-copy">
      <div class="prog-brand-row">
        <!-- ikigai mark: 2×2 grid of rounded squares -->
        <svg class="prog-mark" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="1" y="1" width="9.5" height="9.5" rx="2" fill="currentColor"/>
          <rect x="13.5" y="1" width="9.5" height="9.5" rx="2" fill="currentColor"/>
          <rect x="1" y="13.5" width="9.5" height="9.5" rx="2" fill="currentColor"/>
          <rect x="13.5" y="13.5" width="9.5" height="9.5" rx="2" fill="currentColor"/>
        </svg>
        <span class="section-tag">Accelerator program</span>
      </div>
      <h1 class="prog-h1" id="prog-ikigai-heading">{ikigai.name}</h1>
      <p class="prog-lead">{programs.lead}</p>
      <div class="prog-metrics" role="list">
        {ikigai.details?.metrics.map((m) => (
          <div class="prog-metric" role="listitem">
            <strong class="prog-metric-val">{m.value}</strong>
            <span class="prog-metric-lbl">{m.label}</span>
          </div>
        ))}
      </div>
      <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
        Apply to ikigai Launchpad
      </a>
    </div>
    <figure class="prog-hero-photo">
      <img src={heroPhoto.src} alt={heroPhoto.alt} decoding="async" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <!-- Photo mosaic: program life -->
  <div class="prog-photos">
    {mosaicPhotos.map((p) => (
      <figure class:list={["prog-photo", p.portrait && "prog-photo--portrait"]}>
        <img src={p.src} alt={p.alt} decoding="async" loading="lazy" />
      </figure>
    ))}
  </div>

  <div class="prog-body">

    <!-- 3-column spec: what the program gives you -->
    <section class="prog-spec reveal" aria-label="What ikigai Launchpad includes">
      <div class="prog-spec-header">
        <span class="prog-band-label">What you get</span>
      </div>
      <div class="prog-spec-grid">
        {specPillars.map((p) => (
          <article class="prog-spec-col">
            <span class="prog-spec-num">{p.index}</span>
            <h2 class="prog-spec-name">{p.title}</h2>
            <p class="prog-spec-kicker">{p.kicker}</p>
            <dl class="prog-spec-dl">
              {p.details.map((d) => (
                <div class="prog-spec-item">
                  <dt>{d.label}</dt>
                  <dd>{d.value}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>

    <!-- Apply: CTA + process steps -->
    <section class="prog-apply reveal" aria-label="Apply to ikigai Launchpad">
      <div class="prog-apply-copy">
        <span class="prog-band-label">Applications</span>
        <h2 class="prog-apply-h2">Apply to ikigai<br/>Launchpad.</h2>
        <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
      </div>
      <div class="prog-process" aria-labelledby="prog-process-lbl">
        <h3 class="prog-process-lbl" id="prog-process-lbl">What happens after you apply</h3>
        <ol class="prog-process-list">
          {applicationSteps.map((step, i) => (
            <li class="prog-process-item">
              <span class="prog-process-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="prog-process-step">{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Launch Station: secondary program -->
    {launchStation && (
      <section class="prog-launch reveal" aria-labelledby="prog-launch-heading">
        <div class="prog-launch-copy">
          <span class="prog-band-label">{launchStation.track}</span>
          <h2 class="prog-launch-name" id="prog-launch-heading">{launchStation.name}</h2>
          <p class="prog-launch-body">{launchStation.body}</p>
          <ul class="prog-launch-highlights">
            <li>Free workspace</li>
            <li>Founder community</li>
          </ul>
          <span class="prog-launch-status">{launchStation.cta.label}</span>
        </div>
        <figure class="prog-launch-photo">
          <img src={launchStationPhoto.src} alt={launchStationPhoto.alt} decoding="async" />
        </figure>
      </section>
    )}

  </div>
</div>
