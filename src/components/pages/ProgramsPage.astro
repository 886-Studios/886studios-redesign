---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
---

<div class="page" id="page-programs">
  <div class="pg-hero program-hero">
    <div class="pg-hero-glow"></div>
    <div class="section-tag">{programs.eyebrow}</div>
    <h1 class="program-headline">{programs.title}</h1>
    <p class="section-lead program-summary">{programs.lead}</p>
  </div>
  <div class="pg-divider"></div>
  <div class="program-shell">
    {
      programs.items.map((item) => (
        <article class:list={["program-card", item.details && "program-card-featured"]}>
          <div class="program-card-top">
            {item.learnMoreHref && (
              <a class="card-cta program-card-learn-more" href={item.learnMoreHref} target="_blank" rel="noopener noreferrer">
                Learn more →
              </a>
            )}
            {item.track && <div class="program-track">{item.track}</div>}
            <h2 class="program-name">{item.name}</h2>
            <p class="program-description">{item.body}</p>
            {item.highlights.length > 0 && (
              <div class="program-highlights">
                {item.highlights.map((highlight) => <span class="program-highlight">{highlight}</span>)}
              </div>
            )}
          </div>

          {item.details && (
            <div class="program-stats-row">
              {item.details.metrics.map((metric) => (
                <div class="program-stat">
                  <div class="program-stat-value">{metric.value}</div>
                  <div class="program-stat-label">{metric.label}</div>
                  <div class="program-stat-note">{metric.note}</div>
                </div>
              ))}
            </div>
          )}

          {item.details && (
            <div class="program-detail-grid">
              {item.details.sections.map((section) => (
                <section class="program-detail-panel">
                  <h3 class="program-detail-title">{section.title}</h3>
                  <ul class="program-detail-list">
                    {section.items.map((detail) => <li>{detail}</li>)}
                  </ul>
                </section>
              ))}
            </div>
          )}

          <div class="program-card-footer">
            <div class="program-fit-block">
              <div class="program-fit-label">Best for</div>
              <p class="program-fit">{item.fit}</p>
            </div>
            <div class="program-cta-block">
              {item.cta.type === "link" && (
                <a class="card-cta program-link" href={item.cta.href} target="_blank">
                  {item.cta.label}
                </a>
              )}
              {item.cta.type === "status" && (
                <span class="card-cta program-status-text">{item.cta.label}</span>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>
