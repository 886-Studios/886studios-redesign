---
import { siteContent } from "../../data/siteContent";

const { programs } = siteContent;
const [ikigai, launchStation] = programs.items;
const launchStationHref =
  launchStation?.cta.type === "link" && "href" in launchStation.cta ? launchStation.cta.href : undefined;

const applicationSteps = [
  {
    title: "Submit Application",
  },
  {
    title: "Application Review",
  },
  {
    title: "Interview with 886 Studios",
  },
  {
    title: "Interview with Lifelike Capital",
  },
];
const nextBatch = "Next batch starts Fall 2026.";
const quickFacts = ikigai.details?.metrics ?? [];
const ikigaiNameParts = ikigai.name.split(" ");
const founderBenefitsIntro =
  "ikigai Launchpad gives founders capital, operator access, working space, and a real Taipei batch. These are the core pieces teams use across the 12 weeks and beyond.";

const heroPhoto = {
  src: "/assets/programs/ikigai-audience-theater.jpg",
  alt: "ikigai Launchpad audience gathered in a theater",
};

const launchStationPhoto = {
  src: programs.launchStation.poster.src,
  alt: programs.launchStation.poster.alt,
};

const founderBenefits = [
  {
    label: "Funding",
    title: "$100K USD",
    body: "Capital for the company so founders can focus full-time on building.",
    href: "https://withikigai.com/launch",
  },
  {
    label: "Support",
    title: "1-on-1 Weekly Office Hours",
    body: "Dedicated weekly time with 886 partners to work through product, strategy, and roadblocks.",
    href: "https://withikigai.com/launch/program-offers-1/mentor-office-hours",
  },
  {
    label: "Workshops",
    title: "Founder-Led Workshops",
    body: "Sessions on storytelling, pitch decks, pitching, market sizing, pricing, investor relations, and more.",
    href: "https://withikigai.com/launch/program-offers-1/workshops",
  },
  {
    label: "Fundraising",
    title: "Demo Day",
    body: "A focused moment for teams to present progress and build investor momentum after the batch.",
    href: "https://withikigai.com/launch/program-offers-1/investor-matching",
  },
  {
    label: "Network",
    title: "Guest Speakers",
    body: "Access to operators, founders, and investors who bring practical context into the room.",
    href: "https://withikigai.com/launch",
  },
  {
    label: "Batch",
    title: "Team Building",
    body: "Offsites and founder activities that help the batch build trust, share ideas, and push together.",
    href: "https://withikigai.com/launch/program-offers-1/team-building-activities",
  },
  {
    label: "Workspace",
    title: "Free Office Space in Taipei",
    body: "Desk and office space inside Taiwan Tech Arena for the duration of the program.",
    href: "https://withikigai.com/launch/program-offers-1/office-space-in-taipei",
  },
  {
    label: "Intros",
    title: "Customer and Investor Introductions",
    body: "Warm introductions, investor matching, and help finding the right people as the company takes shape.",
    href: "https://withikigai.com/launch/program-offers-1/warm-intros",
  },
  {
    label: "Beyond",
    title: "Perks, Events, and Alumni Support",
    body: "Startup perks, founder events, and tailored support that continues after the 12-week batch.",
    href: "https://withikigai.com/launch/program-offers-1/exclusive-access-to-corporate-perks",
  },
];
---

<div class="page" id="page-programs">

  <section class="prog-hero" aria-labelledby="prog-ikigai-heading">
    <div class="prog-hero-copy">
      <h1 class="prog-h1" id="prog-ikigai-heading">
        {ikigaiNameParts.map((part, index) => (
          <>
            {index > 0 && <br />}
            <span>{part}</span>
          </>
        ))}
      </h1>
      <p class="prog-lead">{programs.lead}</p>
      <div class="prog-hero-actions">
        <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
        <p class="prog-next-batch">{nextBatch}</p>
      </div>
    </div>
    <aside class="prog-brief-card" aria-label="ikigai Launchpad facts">
      <dl class="prog-brief-facts">
        {quickFacts.map((fact) => (
          <div class="prog-brief-fact">
            <dt>{fact.label}</dt>
            <dd>
              <strong>{fact.value}</strong>
              {fact.note && <span>{fact.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </aside>
  </section>

  <section class="prog-media reveal" aria-label="ikigai Launchpad in session">
    <figure class="prog-hero-photo">
      <img src={heroPhoto.src} alt={heroPhoto.alt} decoding="async" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <div class="prog-body">
    <section class="prog-pillars reveal" aria-labelledby="prog-includes-heading">
      <header class="prog-section-header">
        <div class="prog-section-heading">
          <h2 class="prog-section-title" id="prog-includes-heading">What founders get</h2>
        </div>
        <p class="prog-section-copy">{founderBenefitsIntro}</p>
      </header>
      <div class="prog-benefit-grid">
        {founderBenefits.map((benefit, index) => (
          <a class="prog-benefit-card" href={benefit.href} target="_blank" rel="noopener noreferrer">
            <span class="prog-benefit-index">{String(index + 1).padStart(2, "0")}</span>
            <span class="prog-benefit-label">{benefit.label}</span>
            <strong>{benefit.title}</strong>
            <span>{benefit.body}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="prog-apply reveal" id="prog-apply" aria-label="Apply to ikigai Launchpad">
      <div class="prog-apply-copy">
        <span class="prog-band-label">Applications</span>
        <h2 class="prog-apply-h2">Apply to ikigai Launchpad.</h2>
        <a class="btn-pri prog-cta" href={ikigai.cta.href} target="_blank" rel="noopener noreferrer">
          Apply to ikigai Launchpad
        </a>
        <p class="prog-next-batch prog-next-batch--apply">{nextBatch}</p>
      </div>
      <div class="prog-process-card" aria-labelledby="prog-process-lbl">
        <h3 class="prog-process-lbl" id="prog-process-lbl">Timeline</h3>
        <ol class="prog-process-list">
          {applicationSteps.map((step, index) => (
            <li class="prog-process-item">
              <span class="prog-process-num">{index + 1}</span>
              <span class="prog-process-step-wrap">
                <span class="prog-process-step">{step.title}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {launchStation && launchStationHref && (
      <a class="prog-launch reveal" aria-labelledby="prog-launch-heading" href={launchStationHref}>
        <figure class="prog-launch-photo">
          <img src={launchStationPhoto.src} alt={launchStationPhoto.alt} decoding="async" loading="lazy" />
        </figure>
        <div class="prog-launch-copy">
          <span class="prog-band-label">Also available</span>
          <h2 class="prog-launch-name" id="prog-launch-heading">{launchStation.name}</h2>
          <p class="prog-launch-body">
            Free workspace inside{" "}
            <span class="prog-inline-link prog-inline-link--static">
              Taiwan Tech Arena
            </span>{" "}
            for founders who build better around other ambitious teams.
          </p>
          <ul class="prog-launch-highlights">
            {launchStation.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <span class="prog-launch-status">{launchStation.cta.label}</span>
        </div>
      </a>
    )}

  </div>
</div>
