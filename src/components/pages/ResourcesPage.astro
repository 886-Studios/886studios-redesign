---
import { siteContent } from "../../data/siteContent";

const { resources } = siteContent;

const libraryColors = ["gold", "jade", "purple", "jade", "purple", "gold"];

---

<div class="page resources-page" id="page-resources">

  <!-- Hero -->
  <section class="pg-hero res-pg-hero" aria-labelledby="resources-title">
    <div class="section-tag">Resources</div>
    <h1 class="section-h2 pg-hero-title" id="resources-title">{resources.title}</h1>
    <p class="res-hero-lead">
      Tools, guides, and community access to help founders build, launch, and scale across Taiwan and beyond.
    </p>
  </section>

  <!-- separator — matches the pg-divider pattern used across all inner pages -->
  <div class="pg-divider"></div>

  <div class="res-shell">

    <!-- Resource Library -->
    <section class="res-section res-library" aria-labelledby="res-library-heading">
      <header class="res-section-hdr">
        <div>
          <h2 id="res-library-heading">Resource Library</h2>
          <p>Our guides covering the most common challenges founders face when building a company in Taiwan.</p>
        </div>
      </header>

      <div class="res-card-grid">
        {resources.libraryItems.map((item, i) => (
          <a
            class={`res-card res-card--${libraryColors[i]}`}
            href={item.href}
            aria-label={item.title}
          >
            <h3 class="res-card-title">{item.title}</h3>
            <p class="res-card-desc">{item.description}</p>
            <div class="res-card-footer">
              <span class="res-card-cta">Read guide</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- AMA Feature Card -->
    <section class="res-section res-ama" aria-labelledby="res-ama-heading">
      <div class="res-ama-card">
        <div class="res-ama-body">
          <div class="section-tag">Community</div>
          <h2 id="res-ama-heading">{resources.ama.title}</h2>
          <p class="res-ama-lead">{resources.ama.lead}</p>
          <a class="btn-pri" href={resources.ama.ctaHref} target="_blank" rel="noopener noreferrer">
            {resources.ama.ctaLabel}
          </a>
        </div>

        <div class="res-ama-panel">
          <p class="res-ama-panel-label">How it works</p>
          <ol class="res-ama-steps">
            <li>
              <span class="res-step-num">1</span>
              <span>Submit your question anonymously</span>
            </li>
            <li>
              <span class="res-step-num">2</span>
              <span>Reviewed by our venture partners</span>
            </li>
            <li>
              <span class="res-step-num">3</span>
              <span>Receive a thoughtful, experienced response</span>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- Exclusive Perks -->
    <section class="res-section res-perks" aria-labelledby="res-perks-heading">
      <header class="res-section-hdr">
        <div>
          <h2 id="res-perks-heading">{resources.perks.title}</h2>
          <p>
            Unlock these perks by working with us through{" "}
            <a href={resources.perks.programHref} target="_blank" rel="noopener noreferrer">ikigai Launchpad</a>{" "}
            or Launch Station.
          </p>
        </div>
      </header>

      <div class="res-perks-grid">
        {resources.perks.categories.map((category) => (
          <div class="res-perk-card">
            <div class="res-perk-hdr">
              <span class="res-perk-label">{category.title}</span>
            </div>
            <div class="res-perk-tools">
              {category.items.map((item) => (
                <a
                  class="res-perk-tool"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="res-perk-logo">
                    <img src={item.logoSrc} alt="" loading="lazy" decoding="async" />
                  </span>
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</div>
