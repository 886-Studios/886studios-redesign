---
import { siteContent } from "../../data/siteContent";

const { resources } = siteContent;
---

<div class="page resources-page" id="page-resources">
  <section class="pg-hero" aria-labelledby="resources-title">
    <div class="pg-hero-glow"></div>
    <div class="section-tag">Resources</div>
    <h1 class="section-h2 pg-hero-title" id="resources-title">{resources.title}</h1>
    <p class="section-lead section-lead--flush">Tools and guides to help founders build, launch, and scale in Taiwan.</p>
  </section>
  <main class="resources-shell">
    <section class="resources-section resources-library-section" aria-label="Resource library">
      <header class="resources-section-header">
        <h2>Library</h2>
        <p class="resources-nowrap">Our guides covering the most common challenges founders face when building a company in Taiwan.</p>
      </header>
      <div class="resources-library-list" role="list">
        {resources.libraryItems.map((item) => (
          <a class="resources-library-row" href={item.href} role="listitem">
            <span class="resources-lib-dash" aria-hidden="true">—</span>
            <span class="resources-lib-title">{item.title}</span>
            <span class="resources-lib-desc">{item.description}</span>
            <span class="resources-lib-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
    <section class="resources-section resources-ama-section" aria-labelledby="ama-heading">
      <div class="resources-ama-row">
        <div class="resources-ama-main">
          <div class="section-tag">Community</div>
          <h2 id="ama-heading">{resources.ama.title}</h2>
          <div class="resources-ama-body">
            {resources.ama.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <div class="resources-ama-aside">
          <p>Submit a question and get a thoughtful response from one of our venture partners.</p>
          <a class="card-cta resources-ama-cta" href={resources.ama.ctaHref} target="_blank" rel="noopener noreferrer">
            {resources.ama.ctaLabel} →
          </a>
        </div>
      </div>
    </section>
    <section class="resources-section resources-perks-section" aria-labelledby="perks-heading">
      <header class="resources-section-header">
        <h2 id="perks-heading">{resources.perks.title}</h2>
        <p class="resources-nowrap">
          Unlock these perks by working with us through{" "}
          <a href={resources.perks.programHref} target="_blank" rel="noopener noreferrer">ikigai Launchpad</a>{" "}
          or Launch Station.
        </p>
      </header>
      <div class="resources-perks-cols">
        {resources.perks.categories.map((category) => (
          <div class="resources-perk-col">
            <h3>{category.title}</h3>
            <ul>
              {category.items.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
    <section class="resources-contact-section" aria-label="Need more help">
      <p>{resources.contactPrompt}</p>
      <a class="card-cta" href={resources.contactHref}>{resources.contactLabel}</a>
    </section>
  </main>
</div>
