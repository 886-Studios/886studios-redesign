---
import { siteContent } from "../../data/siteContent";

const { resources } = siteContent;
---

<div class="page" id="page-resources">
  <div class="pg-hero">
    <div class="pg-hero-glow"></div>
    <div class="section-tag">{resources.eyebrow}</div>
    <h1 class="section-h2 pg-hero-title">{resources.title}</h1>
    <p class="section-lead section-lead--flush">{resources.lead}</p>
  </div>
  <div class="pg-divider"></div>
  <div class="section">
    <div class="section-tag">{resources.libraryTitle}</div>
    <div class="res-grid">
      {
        resources.libraryItems.map((item) => (
          <a class="res-item" href={item.href} target="_blank" rel="noopener noreferrer">
            <div class="res-icon">{item.icon}</div>
            <div>
              <div class="res-name">{item.title}</div>
              <div class="res-sub">{item.subtitle}</div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="section-stack-48">
      <div class="section-tag">{resources.ama.eyebrow}</div>
      <div class="pcard pcard--narrow">
        <h3 class="card-title">{resources.ama.title}</h3>
        <p class="card-body">{resources.ama.body}</p>
        <a class="card-cta" href={resources.ama.ctaHref} target="_blank" rel="noopener noreferrer">{resources.ama.ctaLabel}</a>
      </div>
    </div>

    <div class="section-stack-56">
      <div class="section-tag">{resources.perks.eyebrow}</div>
      <p class="perks-note">{resources.perks.note}</p>

      {
        resources.perks.categories.map((category) => (
          <>
            <div class="perk-section-label">{category.title}</div>
            <div class="perks-row">
              {category.items.map((item) => <div class="perk">{item}</div>)}
            </div>
          </>
        ))
      }
    </div>
  </div>
</div>
