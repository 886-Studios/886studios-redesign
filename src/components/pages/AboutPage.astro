---
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";
import { partnerProfileByName } from "../../data/partnerProfiles";

const { about } = siteContent;
---

<div class="page" id="page-about">
  <PageHero eyebrow={about.eyebrow} title={about.title} lead={about.lead} />
  <div class="section">
    <div class="about-cols reveal">
      {
        about.columns.map((column) => (
          <div class="about-col">
            <div class="section-tag about-column-tag">{column.eyebrow}</div>
            {column.title && <h2 class="section-h2 section-h2--compact">{column.title}</h2>}
            {column.paragraphs.map((paragraph, index) => (
              <p class:list={["prose", index > 0 && "prose--spaced"]}>{paragraph}</p>
            ))}
          </div>
        ))
      }
    </div>

    <p class="about-portfolio-cta reveal">
      <a href={about.portfolioCta.href}>{about.portfolioCta.label}</a>
    </p>

    <hr class="divider divider--spaced">

    <div class="reveal">
      <div class="section-tag">{about.teamTitle}</div>
      <div class="team-grid team-grid--ops">
        {
          about.team.map((person) => {
            const teamProfile = partnerProfileByName.get(person.name);

            return (
              <div class:list={["team-card", teamProfile && "team-card--link", teamProfile && "team-card--profile"]}>
                {teamProfile && (
                  <a class="team-card-hit-link" href={`/about/${teamProfile.slug}`} aria-label={`View profile for ${person.name}`}></a>
                )}
                <div class="avatar-wrap">
                  {person.photo
                    ? <img class="avatar-photo" src={person.photo} alt={person.name} width="80" height="80" style={person.objectPosition ? `object-position: ${person.objectPosition}` : undefined} />
                    : <div class="avatar">{person.initials}</div>
                  }
                </div>
                <div class="team-name-row">
                  <div class="team-name">{person.name}</div>
                  <div class="team-socials">
                    <a
                      class="team-social-link team-social-link--linkedin"
                      href={person.linkedinUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${person.name} on LinkedIn`}
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4.98 3.5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5ZM3.5 8.5h2.96V20.5H3.5V8.5Zm5.28 0h2.84v1.64h.04c.4-.75 1.37-1.84 3.34-1.84 3.57 0 4.23 2.35 4.23 5.41v6.79h-2.96v-6.01c0-1.43-.03-3.27-1.99-3.27-2 0-2.31 1.56-2.31 3.17v6.11H8.78V8.5Z" />
                      </svg>
                    </a>
                    {person.xUrl && (
                      <a
                        class="team-social-link team-social-link--x"
                        href={person.xUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${person.name} on X`}
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M18.901 1.153h3.68l-8.04 9.19 9.458 12.504H16.594l-5.8-7.584-6.64 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932L18.9 1.153Zm-1.291 19.492h2.04L6.486 3.24H4.298L17.61 20.645Z" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
                <div class="team-role">{person.role}</div>
              </div>
            );
          })
        }
      </div>
    </div>

    <hr class="divider divider--spaced">

    <div class="reveal reveal-delay-1">
      <div class="section-tag">{about.partnersTitle}</div>
      <div class="team-grid team-grid--partners">
        {
          about.partners.map((partner) => {
            const partnerProfile = partnerProfileByName.get(partner.name);
            const linkedin = partnerProfile?.socials?.find((link) => link.platform === "linkedin");

            return (
              <div class:list={["team-card", partnerProfile && "team-card--link", partnerProfile && "team-card--profile"]}>
                {partnerProfile && (
                  <a class="team-card-hit-link" href={`/about/${partnerProfile.slug}`} aria-label={`View profile for ${partner.name}`}></a>
                )}
                <div class="avatar-wrap">
                  {partner.photo
                    ? <img class="avatar-photo" src={partner.photo} alt={partner.name} width="80" height="80" />
                    : <div class="avatar">{partner.initials}</div>
                  }
                </div>
                <div class="team-name-row">
                  <div class="team-name">{partner.name}</div>
                  {linkedin && (
                    <div class="team-socials">
                      <a
                        class="team-social-link team-social-link--linkedin"
                        href={linkedin.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={linkedin.ariaLabel}
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M4.98 3.5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5ZM3.5 8.5h2.96V20.5H3.5V8.5Zm5.28 0h2.84v1.64h.04c.4-.75 1.37-1.84 3.34-1.84 3.57 0 4.23 2.35 4.23 5.41v6.79h-2.96v-6.01c0-1.43-.03-3.27-1.99-3.27-2 0-2.31 1.56-2.31 3.17v6.11H8.78V8.5Z" />
                        </svg>
                      </a>
                    </div>
                  )}
                </div>
                {partner.company && <div class="team-company">{partner.company}</div>}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</div>
