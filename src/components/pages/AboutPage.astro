---
import { siteContent } from "../../data/siteContent";

const { about } = siteContent;
---

<div class="page" id="page-about">
  <div class="pg-hero">
    <div class="pg-hero-glow"></div>
    <div class="section-tag">{about.eyebrow}</div>
    <h1 class="section-h2 pg-hero-title" set:html={about.title}></h1>
    <p class="section-lead section-lead--flush">{about.lead}</p>
  </div>
  <div class="pg-divider"></div>
  <div class="section">
    <div class="about-cols">
      {
        about.columns.map((column) => (
          <div>
            <div class="section-tag">{column.eyebrow}</div>
            <h2 class="section-h2 section-h2--compact" set:html={column.title}></h2>
            {column.paragraphs.map((paragraph, index) => (
              <p class:list={["prose", index > 0 && "prose--spaced"]}>{paragraph}</p>
            ))}
          </div>
        ))
      }
    </div>

    <hr class="divider divider--spaced">

    <div class="section-tag">{about.teamTitle}</div>
    <div class="team-grid team-grid--ops">
      {
        about.team.map((person) => (
          <div class="team-card">
            <div class="avatar">{person.initials}</div>
            <div class="team-name">{person.name}</div>
            <div class="team-role">{person.role}</div>
          </div>
        ))
      }
    </div>

    <hr class="divider divider--spaced">

    <div class="section-tag">{about.partnersTitle}</div>
    <div class="team-grid team-grid--partners">
      {
        about.partners.map((partner) => (
          <div class="team-card">
            <div class="avatar">{partner.initials}</div>
            <div class="team-name">{partner.name}</div>
          </div>
        ))
      }
    </div>
  </div>
</div>
