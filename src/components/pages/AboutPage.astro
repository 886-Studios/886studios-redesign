---
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";

const { about } = siteContent;
const [titleBeforeSticker, titleAfterSticker] = about.title.split(" real ");
---

<div class="page" id="page-about">
  <PageHero title={about.title} lead={about.lead} accentHeader>
    <Fragment slot="title">
      {titleBeforeSticker}{" "}<span class="founder-sticker"><span class="founder-sticker-text">real</span></span>{" "}{titleAfterSticker}
    </Fragment>
  </PageHero>
  <div class="section">
    <div class="about-cols reveal">
      {
        about.columns.map((column) => (
          <div class="about-col">
            <div class="section-tag about-column-tag">{column.eyebrow}</div>
            {column.title && <h2 class="section-h2 section-h2--compact">{column.title}</h2>}
            {column.paragraphs.map((paragraph, index) => (
              <p class:list={["prose", index > 0 && "prose--spaced"]}>{paragraph}</p>
            ))}
          </div>
        ))
      }
    </div>

    <hr class="divider divider--spaced">

    <div class="reveal reveal-delay-1">
      <div class="section-tag">{about.collaboration.eyebrow}</div>
      <section class="about-collaboration" aria-labelledby="about-collaboration-title">
        <div class="about-collaboration-brand">
          <img
            src={about.collaboration.logo.src}
            alt={about.collaboration.logo.alt}
            width={about.collaboration.logo.width}
            height={about.collaboration.logo.height}
            loading="lazy"
            decoding="async"
          />
          <div>
            <h2 id="about-collaboration-title">{about.collaboration.title}</h2>
          </div>
        </div>

        <div class="about-collaboration-copy">
          <p>{about.collaboration.description}</p>
          <p>
            <a href={about.collaboration.program.href}>
              {about.collaboration.program.label}
            </a>{" "}
            {about.collaboration.programDescription}
          </p>
        </div>

        <div class="about-collaboration-links" aria-label="Lifelike Capital links">
          {about.collaboration.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    </div>

  </div>
</div>

<style>
  .founder-sticker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    vertical-align: middle;
    margin-inline: 0.06em 0.12em;
    min-height: calc(1.5em + 4px);
    padding: 0 0.42em;
    border: 2px solid #e9dfff;
    border-radius: 6px;
    background: #c4a8ff;
    color: #241045;
    box-shadow: 0 3px 10px rgb(0 0 0 / 24%);
    font-size: 0.5em;
    font-weight: 750;
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    transform: translateY(-0.12em) rotate(-9deg);
  }

  .founder-sticker-text {
    /* Center the visible letter height, excluding the font's line-box space. */
    display: block;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }
</style>
