---
import EventCard from "../EventCard.astro";
import { siteContent } from "../../data/siteContent";
import { getLumaEvents } from "../../lib/luma";

const { events } = siteContent;
const lumaEvents = await getLumaEvents();
---

<div class="page" id="page-events">
  <div class="pg-hero">
    <div class="pg-hero-glow"></div>
    <div class="section-tag">{events.eyebrow}</div>
    <h1 class="section-h2 pg-hero-title">{events.title}</h1>
    <p class="section-lead section-lead--flush">{events.lead}</p>
  </div>
  <div class="pg-divider"></div>
  <div class="section">
    <div class="events-calendar-note">
      <div class="events-calendar-copy">
        <div class="ev-title">{events.calendarTitle}</div>
        <div class="ev-meta">{events.calendarText}</div>
      </div>
      <a class="events-calendar-cta" href={events.calendarUrl} target="_blank" rel="noreferrer">
        <span>{events.calendarCta}</span>
        <span class="events-calendar-cta-mark" aria-hidden="true">→</span>
      </a>
    </div>

    {
      lumaEvents.upcomingEvents.length > 0 ? (
        <section class="events-section" aria-labelledby="upcoming-events-title">
          <h2 class="events-section-title" id="upcoming-events-title">{events.upcomingTitle}</h2>
          <div class="events-list">
            {
              lumaEvents.upcomingEvents.map((item) => (
                <EventCard event={item} tag="RSVP" highlight highlightLabel={events.upcomingHighlightLabel} />
              ))
            }
          </div>
        </section>
      ) : (
        <div class="events-empty">
          <div class="ev-title">
            {lumaEvents.error ? events.errorTitle : lumaEvents.isConfigured ? events.emptyTitle : events.setupTitle}
          </div>
          <div class="ev-meta">
            {lumaEvents.error ? events.errorText : lumaEvents.isConfigured ? events.emptyText : events.setupText}
          </div>
        </div>
      )
    }

    {
      lumaEvents.pastEvents.length > 0 && (
        <section class="events-section" aria-labelledby="past-events-title">
          <h2 class="events-section-title" id="past-events-title">{events.pastTitle}</h2>
          <div class="events-list">
            {lumaEvents.pastEvents.map((item) => <EventCard event={item} tag="Past" />)}
          </div>
        </section>
      )
    }
  </div>
</div>
