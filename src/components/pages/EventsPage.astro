---
import { siteContent } from "../../data/siteContent";

const { events } = siteContent;
---

<div class="page" id="page-events">
  <div class="pg-hero">
    <div class="pg-hero-glow"></div>
    <div class="section-tag">{events.eyebrow}</div>
    <h1 class="section-h2 pg-hero-title">{events.title}</h1>
    <p class="section-lead section-lead--flush">{events.lead}</p>
  </div>
  <div class="pg-divider"></div>
  <div class="section">
    <div class="events-list">
      {
        events.items.map((item) => (
          <div class="ev-card">
            <div class="ev-date">
              <div class="ev-month">{item.month}</div>
              <div class="ev-day">{item.day}</div>
            </div>
            <div>
              <div class="ev-title">{item.title}</div>
              <div class="ev-meta">{item.meta}</div>
            </div>
            <div class="ev-tag">{item.tag}</div>
          </div>
        ))
      }
    </div>
    <p class="events-note">{events.note}</p>
  </div>
</div>
