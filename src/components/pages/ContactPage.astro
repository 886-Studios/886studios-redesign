---
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";

const { contact } = siteContent;
---

<div class="page" id="page-contact">
  <PageHero eyebrow={contact.eyebrow} title={contact.title} />
  <div class="section">
    <div class="contact-cols">
      <div class="contact-email-card">
        <p class="contact-email-label">{contact.email.label}</p>
        <p class="contact-email-copy">{contact.email.description}</p>
        <a class="contact-email-address" href={contact.email.href}>
          {contact.email.address}
        </a>
        <a class="btn-pri contact-email-action" href={contact.email.href}>
          {contact.email.button}
        </a>
        <p class="contact-email-note">{contact.email.note}</p>
      </div>
    </div>
  </div>
</div>
