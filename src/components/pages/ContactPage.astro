---
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";

const { contact } = siteContent;
---

<div class="page" id="page-contact">
  <PageHero eyebrow={contact.eyebrow} title={contact.title} />
  <div class="section">
    <div class="contact-cols">
      <div class="form-stack">
        {
          contact.form.fields.map((field) => (
            <div class="form-group">
              <label class="form-lbl">{field.label}</label>
              <input class="form-input" type={field.type} placeholder={field.placeholder} />
            </div>
          ))
        }
        <div class="form-group">
          <label class="form-lbl">{contact.form.messageLabel}</label>
          <textarea class="form-textarea" placeholder={contact.form.messagePlaceholder}></textarea>
        </div>
        <div>
          <button class="btn-pri">{contact.form.button}</button>
        </div>
      </div>
    </div>
  </div>
</div>
