---
import { siteContent } from "../../data/siteContent";

const { launchStation } = siteContent.programs;
---

<div class="page ls-page" id="page-launch-station">
  <div class="ls-return">
    <a class="ls-back" href="/programs">Programs</a>
  </div>
  <section class="ls-hero" aria-labelledby="ls-heading">
    <div class="ls-hero-copy">
      <h1 class="ls-lead" id="ls-heading">{launchStation.lead}</h1>
      <p class="ls-status-note">
        <em>{launchStation.status.prompt}{" "}<a href={siteContent.home.newsletter.publicationUrl}>{launchStation.status.action}</a>{" "}{launchStation.status.detail}</em>
      </p>
    </div>
  </section>
</div>
