---
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";

const { apply } = siteContent;
---

<div class="page" id="page-apply">
  <PageHero eyebrow={apply.eyebrow} title={apply.title} lead={apply.lead} />
  <div class="section app-form-shell">
    <form class="app-form-grid">
      {
        apply.sections.map((section) => (
          <>
            <div class="app-form-section-tag">
              <div class="section-tag">{section.title}</div>
            </div>
            {section.rows.map((row) => (
              <div class:list={["app-form-row", row.length === 1 && "app-form-row--single"]}>
                {row.map((field) => (
                  <div class="app-form-group">
                    <label class="app-form-label">{field.label}</label>
                    {field.type === "textarea" ? (
                      <textarea class="app-form-textarea" placeholder={field.placeholder}></textarea>
                    ) : field.type === "select" ? (
                      <select class="app-form-select">
                        <option value="">{field.placeholder}</option>
                        {field.options?.map((option) => <option value={option}>{option}</option>)}
                      </select>
                    ) : (
                      <input class="app-form-input" type={field.type} placeholder={field.placeholder} />
                    )}
                    <div class="app-form-hint">{field.hint}</div>
                  </div>
                ))}
              </div>
            ))}
          </>
        ))
      }

      <div class="app-form-actions">
        <button type="submit" class="btn-pri">{apply.actions.submitLabel}</button>
        <a class="btn-sec" href={apply.actions.cancelHref}>
          {apply.actions.cancelLabel}
        </a>
      </div>

      <p class="app-form-note">{apply.note}</p>
    </form>
  </div>
</div>
