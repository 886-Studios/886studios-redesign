---
import { siteContent } from "../../data/siteContent";

const { home } = siteContent;
---

<div class="page" id="page-home">
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-orb orb-1"></div>
      <div class="hero-orb orb-2"></div>
      <div class="hero-orb orb-3"></div>
      <div class="hero-grid"></div>
    </div>
    <div class="hero-inner">
      <h1 class="hero-h1">
        {home.hero.titleLead}<br /><em>{home.hero.titleAccent}</em>
      </h1>
      <p class="hero-sub">{home.hero.body}</p>
      <div class="hero-actions">
        <a class="btn-pri" href={home.hero.cta.href} target="_blank">{home.hero.cta.label}</a>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- Programs strip -->
  <div class="section">
    <div class="section-tag">{home.programs.eyebrow}</div>
    <h2 class="section-h2">{home.programs.title}</h2>
    <p class="section-lead">{home.programs.lead}</p>
    <div class="home-programs-flow">
      <article class="home-program-feature">
        <div class="home-program-feature-grid">
          <div class="home-program-feature-label" set:html={home.programs.featured.label}></div>
          <div>
            <h3 class="home-program-feature-title">{home.programs.featured.title}</h3>
            <p class="home-program-feature-copy">{home.programs.featured.body}</p>
            <div class="home-program-feature-meta">
              {home.programs.featured.meta.map((item) => <span>{item}</span>)}
            </div>
          </div>
          <a class="card-cta home-program-feature-link" href={home.programs.featured.ctaHref}>
            {home.programs.featured.ctaLabel}
          </a>
        </div>
      </article>
      <div class="home-program-mini-grid">
        {
          home.programs.secondary.map((item) => (
            <article class="home-program-mini">
              <div class="home-program-mini-label">{item.label}</div>
              <div class="home-program-mini-body">
                <h3 class="home-program-mini-title">{item.title}</h3>
                <p class="home-program-mini-copy">{item.body}</p>
              </div>
              <a class="card-cta" href={item.ctaHref}>
                {item.ctaLabel}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <hr class="divider">

  <div class="section">
    <h2 class="section-h2">{home.founders.title}</h2>
    <div class="logo-wall">
      {
        home.founders.logos.map((logo) => (
          <div class="logo-card" data-exit={logo.exit} title={logo.title}>
            <div class="logo-stage">
              <img class:list={["logo-image", logo.imageClass]} src={logo.src} alt={logo.alt} />
            </div>
            <div class="logo-caption">{logo.name}</div>
          </div>
        ))
      }
    </div>
    <div class="portfolio-strip" aria-label="Portfolio companies">
      <div class="portfolio-marquee">
        <div class="portfolio-track">
          {home.founders.portfolio.map((item) => <span class="portfolio-item">{item}</span>)}
        </div>
        <div class="portfolio-track" aria-hidden="true">
          {home.founders.portfolio.map((item) => <span class="portfolio-item">{item}</span>)}
        </div>
      </div>
    </div>
  </div>

  <div class="section apply-highlight-section">
    <div class="apply-highlight">
      <div class="apply-highlight-inner">
        <div class="apply-highlight-content">
          <h3>{home.applyHighlight.title}</h3>
          <p>{home.applyHighlight.body}</p>
          <div class="apply-highlight-cta">
            <a class="btn-pri" href={home.applyHighlight.primaryCta.href}>
              {home.applyHighlight.primaryCta.label}
            </a>
            <a class="btn-sec" href={home.applyHighlight.secondaryCta.href}>
              {home.applyHighlight.secondaryCta.label}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Newsletter -->
  <div class="nl-strip">
    <div class="nl-inner">
      <div class="nl-text">
        <h3>{home.newsletter.title}</h3>
        <p>{home.newsletter.body}</p>
      </div>
      <div class="nl-form">
        <input class="nl-input" type="email" placeholder={home.newsletter.placeholder} />
        <button class="nl-btn">{home.newsletter.button}</button>
      </div>
    </div>
  </div>
</div>
